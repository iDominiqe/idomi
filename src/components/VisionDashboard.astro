		openLiveSite: 'Open Live Site ↗',
		githubRepo: 'GitHub Repo',
		bioTitle: 'M.Sc. UTM (DMIB) · Microelectronics, Biomedical & Telecom Engineer',
		bioSummary:
			'Master’s in Microelectronics & Biomedical Engineering (UTM DMIB), former medical equipment metrology inspector & biomedical repair engineer, now in Telecom. Freelancing fairly in spare time across Web, Android/Windows (Apple R&D), and Arduino/ESP32/STM32.',
		bioTags: ['Web & 3D', 'Android', 'Windows', 'Apple · R&D', 'Arduino · ESP32 · STM32'],
		bioCalcBtn: '🧮 Calculator',
		bioMoreBtn: 'About Me →',
