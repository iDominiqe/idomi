---
import { PROJECTS } from '../data/ecosystem';

const pathname = Astro.url.pathname;
const isRo = pathname === '/ro' || pathname.startsWith('/ro/');
const isRu = pathname === '/ru' || pathname.startsWith('/ru/');
const lang = isRo ? 'ro' : isRu ? 'ru' : 'en';
const prefix = isRo ? '/ro' : isRu ? '/ru' : '';

const localizedProjects = PROJECTS.map((p) => ({
	...p,
	badge: lang === 'ro' ? p.badgeRo : lang === 'ru' ? p.badgeRu : p.badge,
	description: lang === 'ro' ? p.descriptionRo : lang === 'ru' ? p.descriptionRu : p.description,
	highlights: lang === 'ro' ? p.highlightsRo : lang === 'ru' ? p.highlightsRu : p.highlights,
}));

const featuredRail = localizedProjects.slice(0, 3);
const initialHero = localizedProjects[0];

const i18n = {
	en: {
		featuredBuilds: 'Featured Builds',
		liveCount: '8 Live ⇅',
		weatherAria: 'Weather in Chișinău',
		city: 'Chișinău',
		unitToggleTitle: 'Switch °C / °F',
		refreshWeather: 'Refresh weather',
		openGoogleWeather: 'Open in Google Weather',
		loading: 'Loading...',
		humidity: 'Humidity',
		wind: 'Wind',
		feelsShort: 'Feels like',
		forecastShort: '4-Day Forecast',
		forecastAria: '4-day forecast',
		livePreview: 'Live Preview',
		openSite: 'Open Site',
		chatAria: 'Live Telegram chat with iDominiqe',
		chatTitle: 'Chat with iDominiqe',
		chatLive: 'Telegram Live',
		chatQueue: 'Bot ready · queue',
		yourName: 'Your name',
		newChatTitle: 'Clear local chat history',
		chips: [
			{ label: '🚀 Order a site', prompt: 'Hi! I would like to discuss building a website or web app.' },
			{ label: '🧊 3D / WebGL', prompt: 'Interested in a Three.js / WebGL 3D experience for my project.' },
			{ label: '🔌 ESP32 / App', prompt: 'Can you build an Android/Windows app or an Arduino/ESP32/STM32 device?' },
			{ label: '🛡️ DNS & Security', prompt: 'I have a question about DNS, Cloudflare, domains, or cybersecurity.' },
			{ label: '👋 About you', prompt: 'Tell me about yourself and how we can collaborate!' },
		],
