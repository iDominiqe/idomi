		refreshWeather: 'Actualizează vremea',
		openGoogleWeather: 'Deschide în Google Weather',
		loading: 'Se încarcă...',
		humidity: 'Umiditate',
		wind: 'Vânt',
		feelsShort: 'Se simte',
		forecastShort: 'Prognoză 4 zile',
		forecastAria: 'Prognoză 4 zile',
		livePreview: 'Previzualizare',
		openSite: 'Deschide',
		chatAria: 'Chat live cu iDominiqe pe Telegram',
		chatTitle: 'Chat cu iDominiqe',
		chatLive: 'Telegram Live',
		chatQueue: 'Bot pregătit · așteptare',
		yourName: 'Numele tău',
		newChatTitle: 'Șterge istoricul local',
		chips: [
			{ label: '🚀 Comandă site', prompt: 'Salut! Vreau să discutăm despre crearea unui site sau a unei aplicații web.' },
			{ label: '🧊 3D / WebGL', prompt: 'Sunt interesat de o scenă 3D pe Three.js / WebGL pentru un proiect.' },
			{ label: '🔌 ESP32 / App', prompt: 'Poți face o aplicație Android/Windows sau un dispozitiv pe Arduino/ESP32/STM32?' },
			{ label: '🛡️ DNS & Securitate', prompt: 'Am o întrebare despre DNS, Cloudflare, domeniu sau securitate cibernetică.' },
			{ label: '👋 Despre tine', prompt: 'Povestește-mi despre tine și cum putem colabora!' },
		],
		welcomeMsg: 'Salut! Scrie un mesaj mai jos — ajunge instant în Telegram-ul meu, iar răspunsul meu apare chiar aici în timp real.',
		inputPlaceholder: 'Scrie un mesaj — ajunge direct în Telegram...',
