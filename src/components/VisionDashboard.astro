	},
	ru: {
		featuredBuilds: 'Избранные проекты',
		liveCount: '8 Live ⇅',
		weatherAria: 'Погода в Кишинёве',
		city: 'Кишинёв',
		unitToggleTitle: 'Переключить °C / °F',
		refreshWeather: 'Обновить погоду',
		openGoogleWeather: 'Открыть в Google Погоде',
		loading: 'Загрузка...',
		humidity: 'Влажность',
		wind: 'Ветер',
		feelsShort: 'Ощущается',
		forecastShort: 'Прогноз на 4 дня',
		forecastAria: 'Прогноз на 4 дня',
		livePreview: 'Превью',
		openSite: 'Открыть сайт',
		chatAria: 'Онлайн-чат с iDominiqe в Telegram',
		chatTitle: 'Чат с iDominiqe',
		chatLive: 'Telegram Live',
		chatQueue: 'Бот готов · очередь',
		yourName: 'Ваше имя',
		newChatTitle: 'Очистить локальную историю',
		chips: [
			{ label: '🚀 Заказать сайт', prompt: 'Привет! Хочу обсудить разработку сайта или веб-приложения.' },
			{ label: '🧊 3D / WebGL', prompt: 'Интересует 3D-сцена на Three.js / WebGL для проекта.' },
			{ label: '🔌 ESP32 / Софт', prompt: 'Делаете ли приложения для Android/Windows или устройства на Arduino/ESP32/STM32?' },
			{ label: '🛡️ DNS и Защита', prompt: 'Есть вопрос по DNS, Cloudflare, домену или кибербезопасности.' },
			{ label: '👋 О тебе', prompt: 'Расскажите о себе и условиях сотрудничества!' },
		],
		welcomeMsg: 'Привет! Напишите сообщение ниже — оно сразу придёт ко мне в Telegram, а ответ появится прямо здесь в реальном времени.',
		inputPlaceholder: 'Напишите сообщение — оно уйдёт прямо в Telegram...',
		sendBtn: 'Отправить',
		highlightsTitle: 'Ключевые детали',
		openLiveSite: 'Открыть сайт ↗',
		githubRepo: 'GitHub Repo',
		bioTitle: 'Магистр UTM (DMIB) · Биоинженерия, Микроэлектроника и Телеком',
		bioSummary:
			'Магистр UTM (DMIB), в прошлом инспектор-метролог и биоинженер по ремонту медоборудования, сейчас работаю в телекоммуникациях. Фриланс как хобби без накруток: сайты, Android/Windows софт (Apple в развитии) и устройства Arduino/ESP32/STM32.',
		bioTags: ['Web и 3D', 'Android', 'Windows', 'Apple · R&D', 'Arduino · ESP32 · STM32'],
		bioCalcBtn: '🧮 Калькулятор',
		bioMoreBtn: 'Обо мне →',
	},
}[lang];
---

<div class="vsl-dash not-content" id="vsl-dashboard">
	<!-- Left Bento Rail -->
	<aside class="vsl-rail" aria-label={i18n.featuredBuilds}>
		<!-- Top Card: Featured Builds -->
		<section class="vsl-rail-card" data-tile="1">
			<div class="vsl-rail-head">
				<h2 class="vsl-rail-title">
					<span aria-hidden="true" style="color:#fb923c;">✦</span>
					{i18n.featuredBuilds}
				</h2>
				<a href={`${prefix}/projects/ecosystem/`} class="vsl-rail-meta" style="text-decoration:none;">{i18n.liveCount}</a>
			</div>

			<div class="vsl-mini-stack">
				{featuredRail.map((project, idx) => (
					<div
						class="vsl-mini-card"
						role="button"
						tabindex="0"
						data-spotlight-idx={idx}
						style={`background-image:${project.gradient}`}
						aria-label={`Spotlight ${project.title}`}
					>
						<svg
							style="position:absolute;right:0;top:0;width:58%;height:100%;opacity:0.25;pointer-events:none;"
							viewBox="0 0 180 100"
							fill="none"
						>
							<circle cx="135" cy="30" r="36" stroke="#ffffff" stroke-width="1" stroke-dasharray="4 4" />
							<path d="M90 85 L125 35 L165 65" stroke={project.accent} stroke-width="1.6" />
							<circle cx="125" cy="35" r="3.5" fill={project.accent} />
						</svg>
						<div class="vsl-mini-info">
							<div class="vsl-mini-tag">{project.badge}</div>
							<div class="vsl-mini-title">{project.title}</div>
						</div>
						<button
							type="button"
							class="vsl-mini-play"
							data-preview-id={project.id}
							title={`Preview ${project.title}`}
							aria-label={`Open preview for ${project.title}`}
						>
							<svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor">
								<polygon points="6 4 20 12 6 20 6 4" />
							</svg>
						</button>
					</div>
				))}
			</div>
		</section>

		<!-- Bottom Card: Apple-Style Glass Weather Widget (Chișinău) -->
		<section class="vsl-rail-card vsl-weather-card" id="vsl-weather-card" data-tile="2" aria-label={i18n.weatherAria}>
			<div class="vsl-aw-head">
				<div>
					<div class="vsl-aw-loc">{i18n.city}, MD</div>
					<div id="vsl-w-time" class="vsl-aw-date">--:--</div>
				</div>
				<div class="vsl-w-actions">
					<button type="button" id="vsl-w-unit" class="vsl-w-chip-btn" title={i18n.unitToggleTitle}>°C</button>
					<button type="button" id="vsl-w-refresh" class="vsl-w-chip-btn" title={i18n.refreshWeather} aria-label={i18n.refreshWeather}>↻</button>
				</div>
			</div>

			<div class="vsl-aw-stage">
				<div class="vsl-aw-hero">
					<div class="vsl-aw-temp-col">
						<div id="vsl-w-temp" class="vsl-aw-temp">--°</div>
						<div id="vsl-w-cond" class="vsl-aw-cond">{i18n.loading}</div>
					</div>
					<div id="vsl-w-icon" class="vsl-aw-icon" aria-hidden="true">
						<svg width="72" height="58" viewBox="0 0 64 52" fill="none">
							<defs>
								<radialGradient id="initSun" cx="35%" cy="35%" r="65%">
									<stop offset="0%" stop-color="#fef08a" />
									<stop offset="60%" stop-color="#f59e0b" />
									<stop offset="100%" stop-color="#d97706" />
								</radialGradient>
								<linearGradient id="initCloud" x1="0" y1="0" x2="0" y2="1">
									<stop offset="0%" stop-color="#ffffff" />
									<stop offset="60%" stop-color="#dbe4ef" />
									<stop offset="100%" stop-color="#94a3b8" />
								</linearGradient>
							</defs>
							<circle cx="43" cy="18" r="10.5" fill="url(#initSun)" />
							<path d="M18 43h25.5a9.5 9.5 0 0 0 .8-18.95A13.5 13.5 0 0 0 18.6 20.5a9.8 9.8 0 0 0-.6 19.5Z" fill="url(#initCloud)" />
						</svg>
					</div>
				</div>

				<div class="vsl-aw-stats">
					<div class="vsl-aw-stat">
						<span>{i18n.feelsShort}</span>
						<strong id="vsl-w-feels">--°</strong>
					</div>
					<div class="vsl-aw-stat">
						<span>{i18n.humidity}</span>
						<strong id="vsl-w-hum">--%</strong>
					</div>
					<div class="vsl-aw-stat">
						<span>{i18n.wind}</span>
						<strong id="vsl-w-wind">--</strong>
					</div>
				</div>
			</div>

			<div class="vsl-aw-foot">
				<div class="vsl-aw-foot-head">
					<span>{i18n.forecastShort}</span>
					<a
						href="https://www.google.com/search?q=weather+Chisinau"
						target="_blank"
						rel="noopener noreferrer"
						title={i18n.openGoogleWeather}
					>
						Google ↗
					</a>
				</div>
				<div id="vsl-w-forecast" class="vsl-aw-days" aria-label={i18n.forecastAria}>
					<div class="vsl-aw-pill is-now"><span>--</span><i></i><strong>--°</strong><small>--°</small></div>
					<div class="vsl-aw-pill"><span>--</span><i></i><strong>--°</strong><small>--°</small></div>
					<div class="vsl-aw-pill"><span>--</span><i></i><strong>--°</strong><small>--°</small></div>
					<div class="vsl-aw-pill"><span>--</span><i></i><strong>--°</strong><small>--°</small></div>
				</div>
			</div>
		</section>
	</aside>

	<!-- Right Main Stage Column -->
	<div class="vsl-main-col">
		<!-- Hero Spotlight Stage -->
		<section class="vsl-hero" id="vsl-hero" data-tile="3" aria-label="Featured Ecosystem Spotlight">
			<div class="vsl-hero-art">
				<div class="vsl-hero-mesh" id="vsl-hero-mesh" style={`background:${initialHero.gradient}`}></div>
				<svg class="vsl-hero-grid-svg" viewBox="0 0 560 380" fill="none" xmlns="http://www.w3.org/2000/svg">
					<circle cx="380" cy="185" r="142" stroke="#ffffff" stroke-opacity="0.32" stroke-width="1" stroke-dasharray="5 6" />
					<circle cx="380" cy="185" r="96" stroke="#ffffff" stroke-opacity="0.45" stroke-width="1.2" />
					<circle cx="380" cy="185" r="46" stroke="#60a5fa" stroke-width="1.5" />
					<polygon points="380,68 488,242 272,242" stroke="#ffffff" stroke-opacity="0.38" stroke-width="1.1" fill="rgba(255,255,255,0.03)" />
					<path d="M180 310 L280 220 L380 250 L495 140" stroke="#ffffff" stroke-opacity="0.45" stroke-width="1.4" />
					<circle cx="380" cy="68" r="5" fill="#ffffff" />
					<circle cx="488" cy="242" r="4" fill="#60a5fa" />
					<circle cx="272" cy="242" r="4" fill="#34d399" />
				</svg>
				<div class="vsl-hero-scrim"></div>
			</div>

			<div class="vsl-hero-top">
				<div class="vsl-hot-badge">
					<span aria-hidden="true">✦</span>
					<span id="vsl-hero-badge">{initialHero.badge}</span>
				</div>
				<div class="vsl-hero-dots" id="vsl-hero-dots" role="tablist" aria-label="Spotlight slides">
					{localizedProjects.map((p, idx) => (
						<button
							type="button"
							class={`vsl-hero-dot ${idx === 0 ? 'is-active' : ''}`}
							data-dot-idx={idx}
							aria-label={`Show ${p.title}`}
						></button>
					))}
				</div>
			</div>

			<div class="vsl-hero-body">
				<div class="vsl-tag-row" id="vsl-hero-tags">
					{initialHero.tags.map((tag) => (
						<span class="vsl-chip">{tag}</span>
					))}
				</div>
				<h1 class="vsl-hero-title" id="vsl-hero-title">{initialHero.title}</h1>
				<p class="vsl-hero-desc" id="vsl-hero-desc">{initialHero.description}</p>
			</div>

			<div class="vsl-hero-footer">
				<div class="vsl-cta-group">
					<button type="button" id="vsl-hero-preview-btn" class="vsl-btn-white" data-preview-id={initialHero.id}>
						<svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
							<polygon points="5 3 19 12 5 21 5 3" />
						</svg>
						<span>{i18n.livePreview}</span>
					</button>
					<a
						id="vsl-hero-visit"
						href={initialHero.liveUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="vsl-btn-glass"
					>
						<span>{i18n.openSite}</span>
						<span aria-hidden="true">↗</span>
					</a>
					<a
						id="vsl-hero-repo"
						href={initialHero.repoUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="vsl-btn-circle"
						title={`Source: ${initialHero.repoName}`}
						aria-label="Open GitHub repository"
					>
						•••
					</a>
				</div>

				<div class="vsl-carousel-arrows">
					<button type="button" id="vsl-hero-prev" class="vsl-btn-circle" aria-label="Previous project">
						<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="15 18 9 12 15 6" />
						</svg>
					</button>
					<button type="button" id="vsl-hero-next" class="vsl-btn-circle" aria-label="Next project">
						<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="9 18 15 12 9 6" />
						</svg>
					</button>
				</div>
			</div>
		</section>

		<!-- Bottom Card: Two-Way Live Chat with Telegram Bot -->
		<section class="vsl-chat-card" id="vsl-chat-card" data-tile="4" aria-label={i18n.chatAria}>
			<div class="vsl-chat-head">
				<div class="vsl-chat-title-wrap">
					<span class="vsl-chat-dot" id="vsl-chat-dot" aria-hidden="true"></span>
					<div>
						<h2 class="vsl-strip-title" style="display:flex;align-items:center;gap:8px;">
							<span>{i18n.chatTitle}</span>
							<span class="vsl-chat-status" id="vsl-chat-status">{i18n.chatLive}</span>
						</h2>
					</div>
				</div>

				<div class="vsl-chat-tools">
					<input
						id="vsl-chat-name"
						class="vsl-chat-name"
						type="text"
						maxlength="48"
						placeholder={i18n.yourName}
						aria-label={i18n.yourName}
					/>
					<a
						href="https://t.me/idominiqe"
						target="_blank"
						rel="noopener noreferrer"
						class="vsl-see-all"
					>
						@idominiqe ↗
					</a>
					<button
						type="button"
						id="vsl-chat-reset"
						class="vsl-w-chip-btn"
						title={i18n.newChatTitle}
						aria-label={i18n.newChatTitle}
					>
						↻
					</button>
				</div>
			</div>

			<div class="vsl-chat-chips" aria-label="Quick prompts">
				{i18n.chips.map((c) => (
					<button type="button" class="vsl-chat-chip" data-chat-prompt={c.prompt}>
						{c.label}
					</button>
				))}
			</div>

			<div class="vsl-chat-messages" id="vsl-chat-messages" aria-live="polite">
				<div class="vsl-msg vsl-msg--owner">
					<div class="vsl-msg-meta">iDominiqe · Telegram</div>
					<div class="vsl-msg-text">{i18n.welcomeMsg}</div>
				</div>
			</div>

			<form class="vsl-chat-form" id="vsl-chat-form">
				<input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" hidden />
				<input
					id="vsl-chat-input"
					class="vsl-chat-input"
					type="text"
					maxlength="800"
					required
					placeholder={i18n.inputPlaceholder}
					aria-label={i18n.inputPlaceholder}
				/>
				<button type="submit" id="vsl-chat-send" class="vsl-chat-send">
					<span>{i18n.sendBtn}</span>
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
						<line x1="22" y1="2" x2="11" y2="13" />
						<polygon points="22 2 15 22 11 13 2 9 22 2" />
					</svg>
				</button>
			</form>
		</section>
	</div>
</div>

<!-- Live Project Preview Modal -->
<div id="vsl-preview-modal" class="vsl-modal-backdrop not-content" role="dialog" aria-modal="true" aria-labelledby="vsl-modal-title">
	<div class="vsl-modal-card">
		<div class="vsl-modal-head">
			<div>
				<div id="vsl-modal-badge" style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em;color:rgba(255,255,255,0.62);">
					Live Node
				</div>
				<div id="vsl-modal-title" style="font-size:1.12rem;font-weight:700;">Project Preview</div>
			</div>
			<button type="button" id="vsl-modal-close" class="vsl-icon-btn" aria-label="Close Preview">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
					<line x1="18" y1="6" x2="6" y2="18" />
					<line x1="6" y1="6" x2="18" y2="18" />
				</svg>
			</button>
		</div>

		<div class="vsl-modal-body">
			<div class="vsl-modal-frame-wrap" id="vsl-modal-visual">
				<iframe
					id="vsl-modal-iframe"
					class="vsl-modal-iframe"
					title="Interactive site preview"
					loading="lazy"
					sandbox="allow-scripts allow-same-origin allow-forms"
				></iframe>
			</div>

			<div class="vsl-modal-specs">
				<div>
					<div style="font-size:0.74rem;color:rgba(255,255,255,0.6);font-family:var(--sl-font-mono);" id="vsl-modal-domain"></div>
					<p id="vsl-modal-desc" style="font-size:0.86rem;line-height:1.58;color:rgba(255,255,255,0.88);margin:8px 0 0;"></p>
				</div>

				<div>
					<div style="font-size:0.74rem;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:rgba(255,255,255,0.62);margin-bottom:6px;">
						{i18n.highlightsTitle}
					</div>
					<ul class="vsl-modal-list" id="vsl-modal-highlights"></ul>
				</div>

				<div style="margin-top:auto;display:flex;flex-wrap:wrap;gap:10px;">
					<a id="vsl-modal-live" href="https://idominiqe.com/" target="_blank" rel="noopener noreferrer" class="vsl-btn-white">
						{i18n.openLiveSite}
					</a>
					<a id="vsl-modal-repo" href="https://github.com/iDominiqe" target="_blank" rel="noopener noreferrer" class="vsl-btn-glass">
						{i18n.githubRepo}
					</a>
				</div>
			</div>
		</div>
	</div>
</div>

<script define:vars={{ projectsData: localizedProjects, langCode: lang }}>
	(function () {
		const L = {
			en: {
				feelsLike: 'Feels like',
				today: 'Today',
				offlineWeather: 'Offline · open Google',
				weatherUpdated: 'Chișinău weather updated',
				clear: 'Clear sky',
				clearNight: 'Clear night',
				partly: 'Partly cloudy',
				overcast: 'Overcast',
				fog: 'Fog',
				rain: 'Rain',
				snow: 'Snow',
				storm: 'Thunderstorm',
				mixed: 'Variable',
				welcomeMsg: 'Hi! Write a message below — it goes straight to my Telegram, and my reply will appear right here in real time.',
				sending: 'Sending...',
				queued: '⏳ Queued',
				tgLive: 'Online · Telegram Live',
				tgQueue: 'Standby · Queue',
				tgOffline: 'Offline · Reconnecting',
				historyCleared: 'Local chat history cleared',
				sendFailed: 'Failed to send message',
				sentTg: 'Sent to Telegram',
				savedQueue: 'Saved to Telegram queue',
				botLabel: 'iDominiqe AI · Auto-FAQ',
				localeTag: 'en-US',
				windUnit: 'km/h',
				dirs: ['N', 'NE', 'E', 'SE', 'S', 'SW', 'W', 'NW'],
			},
			ro: {
				feelsLike: 'Se simte',
				today: 'Azi',
				offlineWeather: 'Fără conexiune · Google',
				weatherUpdated: 'Vremea Chișinău actualizată',
				clear: 'Senin',
				clearNight: 'Noapte senină',
				partly: 'Parțial noros',
				overcast: 'Înnorat',
				fog: 'Ceață',
				rain: 'Ploaie',
				snow: 'Ninsoare',
				storm: 'Furtună',
				mixed: 'Variabil',
				welcomeMsg: 'Salut! Scrie un mesaj mai jos — ajunge instant în Telegram-ul meu, iar răspunsul meu apare chiar aici în timp real.',
				sending: 'Se trimite...',
				queued: '⏳ În așteptare',
				tgLive: 'Online · Telegram Live',
				tgQueue: 'Așteptare · Coadă',
				tgOffline: 'Offline · Fără rețea',
				historyCleared: 'Istoricul local al chatului a fost șters',
				sendFailed: 'Nu s-a putut trimite mesajul',
				sentTg: 'Trimis în Telegram',
				savedQueue: 'Salvat în coada Telegram',
				botLabel: 'iDominiqe AI · Auto-FAQ',
				localeTag: 'ro-RO',
				windUnit: 'km/h',
				dirs: ['N', 'NE', 'E', 'SE', 'S', 'SV', 'V', 'NV'],
			},
			ru: {
				feelsLike: 'Ощущается',
				today: 'Сегодня',
				offlineWeather: 'Офлайн · Google',
				weatherUpdated: 'Погода в Кишинёве обновлена',
				clear: 'Ясно',
				clearNight: 'Ясная ночь',
				partly: 'Переменно',
				overcast: 'Облачно',
				fog: 'Туман',
				rain: 'Дождь',
				snow: 'Снег',
				storm: 'Гроза',
				mixed: 'Переменно',
				welcomeMsg: 'Привет! Напишите сообщение ниже — оно сразу придёт ко мне в Telegram, а ответ появится прямо здесь в реальном времени.',
				sending: 'Отправка...',
				queued: '⏳ В очереди',
				tgLive: 'Онлайн · Telegram Live',
				tgQueue: 'Ожидание · Очередь',
				tgOffline: 'Офлайн · Нет сети',
				historyCleared: 'Локальная история чата очищена',
				sendFailed: 'Не удалось отправить сообщение',
				sentTg: 'Отправлено в Telegram',
				savedQueue: 'Сохранено в очередь Telegram',
				botLabel: 'iDominiqe AI · Авто-FAQ',
				localeTag: 'ru-RU',
				windUnit: 'км/ч',
				dirs: ['С', 'СВ', 'В', 'ЮВ', 'Ю', 'ЮЗ', 'З', 'СЗ'],
			},
		}[langCode] || {
			feelsLike: 'Feels like',
			today: 'Today',
			offlineWeather: 'Offline · open Google',
			weatherUpdated: 'Chișinău weather updated',
			clear: 'Clear sky',
			clearNight: 'Clear night',
			partly: 'Partly cloudy',
			overcast: 'Overcast',
			fog: 'Fog',
			rain: 'Rain',
			snow: 'Snow',
			storm: 'Thunderstorm',
			mixed: 'Variable',
			welcomeMsg: 'Hi! Write a message below — it goes straight to my Telegram, and my reply will appear right here in real time.',
			sending: 'Sending...',
			queued: '⏳ Queued',
			tgLive: 'Telegram Live',
			tgQueue: 'Bot ready · queue',
			historyCleared: 'Local chat history cleared',
			sendFailed: 'Failed to send message',
			sentTg: 'Sent to Telegram',
			savedQueue: 'Saved to Telegram queue',
			localeTag: 'en-US',
			windUnit: 'km/h',
		};

		// ======================== 1. HERO SPOTLIGHT & MODAL ========================
		const projects = projectsData;
		let currentIdx = 0;

		const heroMesh = document.getElementById('vsl-hero-mesh');
		const heroBadge = document.getElementById('vsl-hero-badge');
		const heroTags = document.getElementById('vsl-hero-tags');
		const heroTitle = document.getElementById('vsl-hero-title');
		const heroDesc = document.getElementById('vsl-hero-desc');
		const heroPreviewBtn = document.getElementById('vsl-hero-preview-btn');
		const heroVisit = document.getElementById('vsl-hero-visit');
		const heroRepo = document.getElementById('vsl-hero-repo');
		const dotsWrap = document.getElementById('vsl-hero-dots');

		function renderSpotlight(idx) {
			currentIdx = (idx + projects.length) % projects.length;
			const p = projects[currentIdx];
			if (!p) return;

			if (heroMesh) heroMesh.style.background = p.gradient;
			if (heroBadge) heroBadge.textContent = p.badge;
			if (heroTitle) heroTitle.textContent = p.title;
			if (heroDesc) heroDesc.textContent = p.description;
			if (heroTags) {
				heroTags.replaceChildren();
				p.tags.forEach((t) => {
					const chip = document.createElement('span');
					chip.className = 'vsl-chip';
					chip.textContent = t;
					heroTags.appendChild(chip);
				});
			}
			if (heroPreviewBtn) heroPreviewBtn.setAttribute('data-preview-id', p.id);
			if (heroVisit) heroVisit.setAttribute('href', p.liveUrl);
			if (heroRepo) {
				heroRepo.setAttribute('href', p.repoUrl);
				heroRepo.setAttribute('title', 'Source: ' + p.repoName);
			}
			dotsWrap?.querySelectorAll('.vsl-hero-dot').forEach((d, i) => {
				d.classList.toggle('is-active', i === currentIdx);
			});
		}

		document.getElementById('vsl-hero-prev')?.addEventListener('click', () => renderSpotlight(currentIdx - 1));
		document.getElementById('vsl-hero-next')?.addEventListener('click', () => renderSpotlight(currentIdx + 1));

		dotsWrap?.addEventListener('click', (e) => {
			const btn = e.target instanceof Element ? e.target.closest('[data-dot-idx]') : null;
			if (!btn) return;
			renderSpotlight(Number(btn.getAttribute('data-dot-idx') || 0));
		});

		document.querySelectorAll('[data-spotlight-idx]').forEach((card) => {
			card.addEventListener('click', (e) => {
				if (e.target instanceof Element && e.target.closest('[data-preview-id]')) return;
				renderSpotlight(Number(card.getAttribute('data-spotlight-idx') || 0));
			});
		});

		const modal = document.getElementById('vsl-preview-modal');
		const modalIframe = document.getElementById('vsl-modal-iframe');
		const modalTitle = document.getElementById('vsl-modal-title');
		const modalBadge = document.getElementById('vsl-modal-badge');
		const modalDomain = document.getElementById('vsl-modal-domain');
		const modalDesc = document.getElementById('vsl-modal-desc');
		const modalHighlights = document.getElementById('vsl-modal-highlights');
		const modalLive = document.getElementById('vsl-modal-live');
		const modalRepo = document.getElementById('vsl-modal-repo');

		function openPreview(projectId) {
			const p = projects.find((item) => item.id === projectId) || projects[0];
			if (!p || !modal) return;
			if (modalTitle) modalTitle.textContent = p.title;
			if (modalBadge) modalBadge.textContent = p.badge + ' · ' + p.stack;
			if (modalDomain) modalDomain.textContent = 'https://' + p.domainLabel + '/';
			if (modalDesc) modalDesc.textContent = p.description;
			if (modalHighlights) {
				modalHighlights.replaceChildren();
				p.highlights.forEach((h) => {
					const li = document.createElement('li');
					li.textContent = h;
					modalHighlights.appendChild(li);
				});
			}
			if (modalLive) modalLive.setAttribute('href', p.liveUrl);
			if (modalRepo) modalRepo.setAttribute('href', p.repoUrl);
			if (modalIframe instanceof HTMLIFrameElement) {
				modalIframe.src = p.liveUrl;
			}
			modal.classList.add('is-open');
		}

		function closePreview() {
			if (!modal) return;
			modal.classList.remove('is-open');
			if (modalIframe instanceof HTMLIFrameElement) {
				modalIframe.src = 'about:blank';
			}
		}

		document.addEventListener('click', (e) => {
			const btn = e.target instanceof Element ? e.target.closest('[data-preview-id]') : null;
			if (!btn) return;
			e.stopPropagation();
			const id = btn.getAttribute('data-preview-id');
			if (id) openPreview(id);
		});

		document.getElementById('vsl-modal-close')?.addEventListener('click', closePreview);
		modal?.addEventListener('click', (e) => {
			if (e.target === modal) closePreview();
		});
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && modal?.classList.contains('is-open')) closePreview();
		});

		// ======================== 2. CHISINAU WEATHER WIDGET ========================
		const WEATHER_API =
			'https://api.open-meteo.com/v1/forecast?latitude=47.0105&longitude=28.8638&current=temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,wind_speed_10m,wind_direction_10m,is_day&daily=weather_code,temperature_2m_max,temperature_2m_min&timezone=Europe%2FChisinau&forecast_days=4';
		const WEATHER_CACHE_KEY = 'vslChisinauWeatherV2';
		const WEATHER_UNIT_KEY = 'vslWeatherUnit';
		let weatherUnit = (() => {
			try {
				return localStorage.getItem(WEATHER_UNIT_KEY) === 'F' ? 'F' : 'C';
			} catch (_) {
				return 'C';
			}
		})();
		let latestWeatherPayload = null;

		const wUnitBtn = document.getElementById('vsl-w-unit');
		const wRefreshBtn = document.getElementById('vsl-w-refresh');
		const wIconEl = document.getElementById('vsl-w-icon');
		const wTempEl = document.getElementById('vsl-w-temp');
		const wCondEl = document.getElementById('vsl-w-cond');
		const wFeelsEl = document.getElementById('vsl-w-feels');
		const wHumEl = document.getElementById('vsl-w-hum');
		const wWindEl = document.getElementById('vsl-w-wind');
		const wTimeEl = document.getElementById('vsl-w-time');
		const wForecastEl = document.getElementById('vsl-w-forecast');

		function updateChisinauClock() {
			if (!wTimeEl) return;
			try {
				const now = new Date();
				const t = new Intl.DateTimeFormat('en-GB', {
					timeZone: 'Europe/Chisinau',
					hour: '2-digit',
					minute: '2-digit',
				}).format(now);
				const d = new Intl.DateTimeFormat(L.localeTag, {
					timeZone: 'Europe/Chisinau',
					weekday: 'short',
					day: 'numeric',
					month: 'short',
				}).format(now);
				wTimeEl.textContent = `${t} · ${d}`;
			} catch (_) {
				wTimeEl.textContent = '--:--';
			}
		}
		updateChisinauClock();
		setInterval(updateChisinauClock, 30000);

		function compassDir(deg) {
			if (deg === undefined || deg === null || Number.isNaN(Number(deg))) return '';
			const idx = Math.round(((Number(deg) % 360) + 360) % 360 / 45) % 8;
			return ' ' + (L.dirs?.[idx] || '');
		}

		function weatherMeta(code, isDay = 1) {
			if (code === 0) return { label: isDay ? L.clear : L.clearNight, kind: isDay ? 'sun' : 'moon' };
			if (code === 1 || code === 2) return { label: L.partly, kind: 'partly' };
			if (code === 3) return { label: L.overcast, kind: 'cloud' };
			if (code === 45 || code === 48) return { label: L.fog, kind: 'cloud' };
			if ([51, 53, 55, 61, 63, 65, 80, 81, 82].includes(code)) return { label: L.rain, kind: 'rain' };
			if ([71, 73, 75, 77, 85, 86].includes(code)) return { label: L.snow, kind: 'snow' };
			if ([95, 96, 99].includes(code)) return { label: L.storm, kind: 'storm' };
			return { label: L.mixed, kind: 'partly' };
		}

		function createWeatherSvg(kind, width = 72, height = 58) {
			const ns = 'http://www.w3.org/2000/svg';
			const uid = Math.random().toString(36).slice(2, 7);
			const svg = document.createElementNS(ns, 'svg');
			svg.setAttribute('width', String(width));
			svg.setAttribute('height', String(height));
			svg.setAttribute('viewBox', '0 0 64 52');
			svg.setAttribute('fill', 'none');

			const defs = document.createElementNS(ns, 'defs');
			const sunGrad = document.createElementNS(ns, 'radialGradient');
			sunGrad.id = `sg_${uid}`;
			sunGrad.setAttribute('cx', '35%');
			sunGrad.setAttribute('cy', '35%');
			sunGrad.setAttribute('r', '65%');
			[
				['0%', '#fef08a'],
				['58%', '#fbbf24'],
				['100%', '#d97706'],
			].forEach(([o, c]) => {
				const st = document.createElementNS(ns, 'stop');
				st.setAttribute('offset', o);
				st.setAttribute('stop-color', c);
				sunGrad.appendChild(st);
			});

			const cldGrad = document.createElementNS(ns, 'linearGradient');
			cldGrad.id = `cg_${uid}`;
			cldGrad.setAttribute('x1', '0');
			cldGrad.setAttribute('y1', '0');
			cldGrad.setAttribute('x2', '0');
			cldGrad.setAttribute('y2', '1');
			[
				['0%', '#ffffff'],
				['55%', '#e2e8f0'],
				['100%', '#94a3b8'],
			].forEach(([o, c]) => {
				const st = document.createElementNS(ns, 'stop');
				st.setAttribute('offset', o);
				st.setAttribute('stop-color', c);
				cldGrad.appendChild(st);
			});

			const moonGrad = document.createElementNS(ns, 'radialGradient');
			moonGrad.id = `mg_${uid}`;
			moonGrad.setAttribute('cx', '30%');
			moonGrad.setAttribute('cy', '30%');
			moonGrad.setAttribute('r', '70%');
			[
				['0%', '#e0f2fe'],
				['65%', '#93c5fd'],
				['100%', '#3b82f6'],
			].forEach(([o, c]) => {
				const st = document.createElementNS(ns, 'stop');
				st.setAttribute('offset', o);
				st.setAttribute('stop-color', c);
				moonGrad.appendChild(st);
			});

			defs.append(sunGrad, cldGrad, moonGrad);
			svg.appendChild(defs);

			const drawCloud = (dy = 0) => {
				const p = document.createElementNS(ns, 'path');
				p.setAttribute('d', `M17 ${41 + dy}h26.5a9.5 9.5 0 0 0 .8-18.95A13.5 13.5 0 0 0 18.6 ${18.5 + dy}a9.8 9.8 0 0 0-1.6 19.5Z`);
				p.setAttribute('fill', `url(#cg_${uid})`);
				p.setAttribute('style', 'filter: drop-shadow(0 4px 6px rgba(0,0,0,0.28));');
				svg.appendChild(p);
			};

			const drawSun = (cx, cy, r) => {
				const glow = document.createElementNS(ns, 'circle');
				glow.setAttribute('cx', String(cx));
				glow.setAttribute('cy', String(cy));
				glow.setAttribute('r', String(r + 5));
				glow.setAttribute('fill', 'rgba(251, 191, 36, 0.22)');
				const orb = document.createElementNS(ns, 'circle');
				orb.setAttribute('cx', String(cx));
				orb.setAttribute('cy', String(cy));
				orb.setAttribute('r', String(r));
				orb.setAttribute('fill', `url(#sg_${uid})`);
				svg.append(glow, orb);
			};

			if (kind === 'sun') {
				drawSun(32, 26, 13);
			} else if (kind === 'moon') {
				const m = document.createElementNS(ns, 'path');
				m.setAttribute('d', 'M41 31.5A14.5 14.5 0 1 1 25.5 11a11.5 11.5 0 0 0 15.5 20.5Z');
				m.setAttribute('fill', `url(#mg_${uid})`);
				svg.appendChild(m);
			} else if (kind === 'partly') {
				drawSun(43, 18, 10.5);
				drawCloud(2);
			} else if (kind === 'rain') {
				drawCloud(-3);
				[22, 32, 42].forEach((rx, idx) => {
					const d = document.createElementNS(ns, 'path');
					d.setAttribute('d', `M${rx} ${40 + (idx % 2) * 2}c0 2.5-2.5 5-2.5 6.8a2.5 2.5 0 0 0 5 0c0-1.8-2.5-4.3-2.5-6.8Z`);
					d.setAttribute('fill', '#60a5fa');
					svg.appendChild(d);
				});
			} else if (kind === 'storm') {
				drawCloud(-4);
				const bolt = document.createElementNS(ns, 'path');
				bolt.setAttribute('d', 'M33 34l-5 8h4.5l-2 7 7.5-9.5h-4.5L36 34h-3Z');
				bolt.setAttribute('fill', '#fbbf24');
				svg.appendChild(bolt);
			} else if (kind === 'snow') {
				drawCloud(-3);
				[22, 32, 42].forEach((sx, idx) => {
					const dot = document.createElementNS(ns, 'circle');
					dot.setAttribute('cx', String(sx));
					dot.setAttribute('cy', String(43 + (idx % 2) * 3));
					dot.setAttribute('r', '2.3');
					dot.setAttribute('fill', '#e0f2fe');
					svg.appendChild(dot);
				});
			} else {
				drawCloud(1);
			}
			return svg;
		}

		function fmtTemp(celsius) {
			const val = weatherUnit === 'F' ? (Number(celsius) * 9) / 5 + 32 : Number(celsius);
			return `${Math.round(val)}°`;
		}

		function renderWeather(data) {
			if (!data?.current || !data?.daily) return;
			latestWeatherPayload = data;
			if (wUnitBtn) wUnitBtn.textContent = `°${weatherUnit}`;

			const cur = data.current;
			const meta = weatherMeta(Number(cur.weather_code), Number(cur.is_day ?? 1));
			if (wIconEl) wIconEl.replaceChildren(createWeatherSvg(meta.kind, 74, 58));
			if (wTempEl) wTempEl.textContent = `${fmtTemp(cur.temperature_2m)}${weatherUnit}`;
			if (wCondEl) wCondEl.textContent = meta.label;
			if (wFeelsEl) wFeelsEl.textContent = fmtTemp(cur.apparent_temperature);
			if (wHumEl) wHumEl.textContent = `${Math.round(Number(cur.relative_humidity_2m))}%`;
			if (wWindEl) wWindEl.textContent = `${Math.round(Number(cur.wind_speed_10m))} ${L.windUnit}${compassDir(cur.wind_direction_10m)}`;

			if (wForecastEl && Array.isArray(data.daily.time)) {
				wForecastEl.replaceChildren();
				const dayFmt = new Intl.DateTimeFormat(L.localeTag, { weekday: 'short', timeZone: 'Europe/Chisinau' });
				data.daily.time.slice(0, 4).forEach((isoDate, i) => {
					const box = document.createElement('div');
					box.className = `vsl-aw-pill ${i === 0 ? 'is-now' : ''}`;

					const nameEl = document.createElement('span');
					nameEl.textContent = i === 0 ? L.today : dayFmt.format(new Date(`${isoDate}T12:00:00Z`)).replace('.', '');

					const code = Number(data.daily.weather_code?.[i] ?? 1);
					const miniIcon = createWeatherSvg(weatherMeta(code, 1).kind, 28, 22);

					const hiEl = document.createElement('strong');
					hiEl.textContent = fmtTemp(data.daily.temperature_2m_max?.[i] ?? 0);

					const loEl = document.createElement('small');
					loEl.textContent = fmtTemp(data.daily.temperature_2m_min?.[i] ?? 0);

					box.append(nameEl, miniIcon, hiEl, loEl);
					wForecastEl.appendChild(box);
				});
			}
		}

		async function loadWeather(forceFresh = false) {
			if (!forceFresh) {
				try {
					const raw = sessionStorage.getItem(WEATHER_CACHE_KEY);
					if (raw) {
						const cached = JSON.parse(raw);
						if (cached?.ts && Date.now() - cached.ts < 600000 && cached.data) {
							renderWeather(cached.data);
							return;
						}
					}
				} catch (_) {}
			}

			try {
				const res = await fetch(WEATHER_API);
				if (!res.ok) throw new Error('Weather API HTTP ' + res.status);
				const data = await res.json();
				try {
					sessionStorage.setItem(WEATHER_CACHE_KEY, JSON.stringify({ ts: Date.now(), data }));
				} catch (_) {}
				renderWeather(data);
			} catch (_) {
				if (wCondEl) wCondEl.textContent = L.offlineWeather;
			}
		}

		wUnitBtn?.addEventListener('click', () => {
			weatherUnit = weatherUnit === 'C' ? 'F' : 'C';
			try {
				localStorage.setItem(WEATHER_UNIT_KEY, weatherUnit);
			} catch (_) {}
			if (latestWeatherPayload) renderWeather(latestWeatherPayload);
		});

		wRefreshBtn?.addEventListener('click', () => {
			loadWeather(true);
			window.__vslToast?.(L.weatherUpdated);
		});

		loadWeather(false);

		// ======================== 3. LIVE TELEGRAM CHAT ========================
		const isLocalHost = window.location.hostname === '127.0.0.1' || window.location.hostname === 'localhost';
		const CHAT_API = isLocalHost ? 'https://idominiqe.com/api/chat' : '/api/chat';
		const CHAT_SESSION_KEY = 'vslChatSession';
		const CHAT_NAME_KEY = 'vslChatName';

		const chatDot = document.getElementById('vsl-chat-dot');
		const chatStatusEl = document.getElementById('vsl-chat-status');
		const chatNameInput = document.getElementById('vsl-chat-name');
		const chatMessagesEl = document.getElementById('vsl-chat-messages');
		const chatForm = document.getElementById('vsl-chat-form');
		const chatInput = document.getElementById('vsl-chat-input');
		const chatSendBtn = document.getElementById('vsl-chat-send');
		const chatResetBtn = document.getElementById('vsl-chat-reset');

		let chatState = (() => {
			try {
				const raw = localStorage.getItem(CHAT_SESSION_KEY);
				return raw ? JSON.parse(raw) : { sessionId: '', sessionToken: '', messages: [] };
			} catch (_) {
				return { sessionId: '', sessionToken: '', messages: [] };
			}
		})();

		if (chatNameInput instanceof HTMLInputElement) {
			try {
				chatNameInput.value = localStorage.getItem(CHAT_NAME_KEY) || '';
			} catch (_) {}
			chatNameInput.addEventListener('input', () => {
				try {
					localStorage.setItem(CHAT_NAME_KEY, chatNameInput.value.trim());
				} catch (_) {}
			});
		}

		function saveChatState() {
			try {
				localStorage.setItem(CHAT_SESSION_KEY, JSON.stringify(chatState));
			} catch (_) {}
		}

		function formatMsgTime(ts) {
			try {
				return new Date(ts).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
			} catch (_) {
				return '';
			}
		}

		function renderChatMessages(overrideList) {
			if (!chatMessagesEl) return;
			const list = Array.isArray(overrideList) ? overrideList : chatState.messages || [];
			chatMessagesEl.replaceChildren();

			const welcome = document.createElement('div');
			welcome.className = 'vsl-msg vsl-msg--owner';
			const wMeta = document.createElement('div');
			wMeta.className = 'vsl-msg-meta';
			wMeta.textContent = 'iDominiqe · Telegram';
			const wText = document.createElement('div');
			wText.className = 'vsl-msg-text';
			wText.textContent = L.welcomeMsg;
			welcome.append(wMeta, wText);
			chatMessagesEl.appendChild(welcome);

			list.forEach((msg) => {
				const row = document.createElement('div');
				row.className = `vsl-msg ${msg.role === 'visitor' ? 'vsl-msg--visitor' : 'vsl-msg--owner'}`;

				const meta = document.createElement('div');
				meta.className = 'vsl-msg-meta';
				const timeStr = msg.ts ? formatMsgTime(msg.ts) : '';
				if (msg.role === 'visitor') {
					const statusTxt = msg.pending ? L.sending : msg.queued ? L.queued : '✓ Telegram';
					meta.textContent = `${timeStr ? timeStr + ' · ' : ''}${statusTxt}`;
				} else if (msg.role === 'bot') {
					meta.textContent = `${L.botLabel || 'iDominiqe AI · Auto-FAQ'}${timeStr ? ' · ' + timeStr : ''}`;
				} else {
					meta.textContent = `iDominiqe · Telegram${timeStr ? ' · ' + timeStr : ''}`;
				}

				const body = document.createElement('div');
				body.className = 'vsl-msg-text';
				body.textContent = msg.text || '';

				row.append(meta, body);
				chatMessagesEl.appendChild(row);
			});

			chatMessagesEl.scrollTop = chatMessagesEl.scrollHeight;
		}

		function setChatConnState(state) {
			const mode = state === 'offline' ? 'offline' : state === 'queued' ? 'queued' : 'online';
			[chatDot, chatStatusEl].forEach((el) => {
				if (!el) return;
				el.classList.remove('is-online', 'is-queued', 'is-offline');
				el.classList.add(`is-${mode}`);
			});
			if (chatStatusEl) {
				chatStatusEl.textContent = mode === 'offline' ? L.tgOffline : mode === 'queued' ? L.tgQueue : L.tgLive;
			}
		}

		async function fetchChatStatus() {
			if (!navigator.onLine) {
				setChatConnState('offline');
				return;
			}
			try {
				const res = await fetch(`${CHAT_API}/status?_t=${Date.now()}`, { cache: 'no-store' });
				if (!res.ok) {
					setChatConnState('offline');
					return;
				}
				const data = await res.json();
				if (data?.ok) setChatConnState(data.ownerBound ? 'online' : 'queued');
			} catch (_) {
				setChatConnState('offline');
			}
		}

		let pollTimer = null;
		let pollInFlight = false;
		async function pollMessages(force = false) {
			if (!chatState.sessionId || !chatState.sessionToken) return;
			if (!navigator.onLine) {
				setChatConnState('offline');
				return;
			}
			if (!force && document.visibilityState !== 'visible') return;
			if (pollInFlight) return;
			pollInFlight = true;
			try {
				const url = `${CHAT_API}/poll?session=${encodeURIComponent(chatState.sessionId)}&_t=${Date.now()}`;
				const res = await fetch(url, {
					cache: 'no-store',
					headers: { 'X-Session-Token': chatState.sessionToken },
				});
				if (!res.ok) return;
				const data = await res.json();
				if (data?.ok && Array.isArray(data.messages)) {
					setChatConnState(data.ownerBound ? 'online' : 'queued');
					const prevJson = JSON.stringify(chatState.messages || []);
					const nextJson = JSON.stringify(data.messages);
					if (prevJson !== nextJson) {
						chatState.messages = data.messages;
						saveChatState();
						renderChatMessages();
					}
				}
			} catch (_) {
				setChatConnState('offline');
			} finally {
				pollInFlight = false;
			}
		}

		function ensurePolling() {
			if (pollTimer) clearInterval(pollTimer);
			if (chatState.sessionId && chatState.sessionToken) {
				pollTimer = setInterval(() => pollMessages(false), 3000);
			}
		}

		document.addEventListener('visibilitychange', () => {
			if (document.visibilityState === 'visible') {
				fetchChatStatus();
				pollMessages(true);
			}
		});
		window.addEventListener('focus', () => {
			fetchChatStatus();
			pollMessages(true);
		});
		window.addEventListener('pageshow', () => pollMessages(true));
		window.addEventListener('online', () => {
			fetchChatStatus();
			pollMessages(true);
		});
		window.addEventListener('offline', () => setChatConnState('offline'));
		setInterval(fetchChatStatus, 25000);

		document.querySelectorAll('[data-chat-prompt]').forEach((chip) => {
			chip.addEventListener('click', () => {
				const prompt = chip.getAttribute('data-chat-prompt') || '';
				if (chatInput instanceof HTMLInputElement) {
					chatInput.value = prompt;
					chatInput.focus();
				}
			});
		});

		chatResetBtn?.addEventListener('click', () => {
			chatState = { sessionId: '', sessionToken: '', messages: [] };
			try {
				localStorage.removeItem(CHAT_SESSION_KEY);
			} catch (_) {}
			if (pollTimer) clearInterval(pollTimer);
			renderChatMessages();
			window.__vslToast?.(L.historyCleared);
		});

		chatForm?.addEventListener('submit', async (e) => {
			e.preventDefault();
			if (!(chatInput instanceof HTMLInputElement)) return;
			const text = chatInput.value.trim();
			if (!text) return;

			const name = chatNameInput instanceof HTMLInputElement ? chatNameInput.value.trim() : '';
			const honeyInput = chatForm.querySelector('input[name="website"]');
			const website = honeyInput instanceof HTMLInputElement ? honeyInput.value : '';

			const optimisticList = [
				...(chatState.messages || []),
				{ id: 'pending', role: 'visitor', text, ts: Date.now(), pending: true },
			];
			renderChatMessages(optimisticList);
			chatInput.value = '';
			if (chatSendBtn instanceof HTMLButtonElement) chatSendBtn.disabled = true;

			try {
				const res = await fetch(`${CHAT_API}/send`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						name,
						text,
						lang: langCode,
						website,
						sessionId: chatState.sessionId || undefined,
						sessionToken: chatState.sessionToken || undefined,
					}),
				});
				const data = await res.json().catch(() => null);
				if (!res.ok || !data?.ok) {
					throw new Error(data?.error || L.sendFailed);
				}

				const hydrated = (data.messages || []).map((m, idx, arr) =>
					idx === arr.length - 1 && data.queued ? { ...m, queued: true } : m
				);
				chatState = {
					sessionId: data.sessionId,
					sessionToken: data.sessionToken,
					messages: hydrated,
				};
				saveChatState();
				setChatConnState(data.ownerBound ? 'online' : 'queued');
				renderChatMessages();
				ensurePolling();
				window.__vslToast?.(data.delivered ? L.sentTg : L.savedQueue);
			} catch (err) {
				renderChatMessages();
				window.__vslToast?.(err instanceof Error ? err.message : L.sendFailed);
			} finally {
				if (chatSendBtn instanceof HTMLButtonElement) chatSendBtn.disabled = false;
			}
		});

		renderChatMessages();
		fetchChatStatus();
		if (chatState.sessionId && chatState.sessionToken) {
			pollMessages(true);
			ensurePolling();
		}
	})();
</script>
