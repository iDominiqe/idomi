---
import Search from 'virtual:starlight/components/Search';
import config from 'virtual:starlight/user-config';
import { SOCIALS } from '../data/ecosystem';

const shouldRenderSearch = config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
const pathname = Astro.url.pathname;
const isRo = pathname === '/ro' || pathname.startsWith('/ro/');
const isRu = pathname === '/ru' || pathname.startsWith('/ru/');
const lang = isRo ? 'ro' : isRu ? 'ru' : 'en';
const prefix = isRo ? '/ro' : isRu ? '/ru' : '';
const stripped = (isRo || isRu) ? pathname.replace(/^\/(ro|ru)(?=\/|$)/, '') || '/' : pathname;

const enPath = stripped;
const roPath = stripped === '/' ? '/ro/' : `/ro${stripped}`;
const ruPath = stripped === '/' ? '/ru/' : `/ru${stripped}`;

const copy = {
	en: {
		mainNav: 'Main sections',
		language: 'Language',
		ecoStatus: 'Ecosystem Status',
		profileAria: 'iDominiqe profile & links',
		liveNodes: '8 Live Nodes',
		liveTel: 'Live telemetry',
		edgeTel: 'Edge Telemetry',
		subRepos: '8 Subdomain Repos',
		ready: 'Ready',
		customThemes: 'Customize Theme Studio',
		presets: '5 Presets',
		devChannels: 'Developer Channels',
		ecoHubs: 'Ecosystem Hubs',
		channels: 'Channels',
		aboutMe: 'About Me & Bio',
		calculator: 'Project Calculator',
		guidesLink: 'Guides & Presets',
		tabs: [
			{ label: 'Home', href: '/', active: stripped === '/' },
			{ label: 'Projects', href: '/projects/ecosystem/', active: stripped.startsWith('/projects') },
			{ label: 'Calculator', href: '/calculator/', active: stripped.startsWith('/calculator') },
			{ label: 'About', href: '/about/', active: stripped.startsWith('/about') },
			{
				label: 'Blog',
				href: '/blog/',
				active: stripped.startsWith('/blog') || stripped.startsWith('/guides') || stripped.startsWith('/reference'),
			},
		],
	},
	ro: {
		mainNav: 'Secțiuni principale',
		language: 'Limbă',
		ecoStatus: 'Stare ecosistem',
		profileAria: 'Profil și linkuri iDominiqe',
		liveNodes: '8 Noduri Live',
		liveTel: 'Telemetrie live',
		edgeTel: 'Telemetrie Edge',
		subRepos: '8 Repozitorii Subdomeniu',
		ready: 'Pregătit',
		customThemes: 'Personalizează Teme',
		presets: '5 Preseturi',
		devChannels: 'Canale dezvoltator',
		ecoHubs: 'Huburi Ecosistem',
		channels: 'Canale',
		aboutMe: 'Despre Mine & Bio',
		calculator: 'Calculator Proiect',
		guidesLink: 'Ghiduri & Teme',
		tabs: [
			{ label: 'Acasă', href: '/ro/', active: stripped === '/' },
			{ label: 'Proiecte', href: '/ro/projects/ecosystem/', active: stripped.startsWith('/projects') },
			{ label: 'Calculator', href: '/ro/calculator/', active: stripped.startsWith('/calculator') },
			{ label: 'Despre', href: '/ro/about/', active: stripped.startsWith('/about') },
			{
				label: 'Blog',
				href: '/ro/blog/',
				active: stripped.startsWith('/blog') || stripped.startsWith('/guides') || stripped.startsWith('/reference'),
			},
		],
	},
	ru: {
		mainNav: 'Основные разделы',
		language: 'Язык',
		ecoStatus: 'Статус экосистемы',
		profileAria: 'Профиль и ссылки iDominiqe',
		liveNodes: '8 Живых Нод',
		liveTel: 'Живая телеметрия',
		edgeTel: 'Edge-телеметрия',
		subRepos: '8 Репозиториев поддоменов',
		ready: 'Готово',
		customThemes: 'Настроить Студию Тем',
		presets: '5 Пресетов',
		devChannels: 'Каналы разработчика',
		ecoHubs: 'Хабы экосистемы',
		channels: 'Каналы',
		aboutMe: 'Обо мне и Био',
		calculator: 'Калькулятор проекта',
		guidesLink: 'Гайды и Темы',
		tabs: [
			{ label: 'Главная', href: '/ru/', active: stripped === '/' },
			{ label: 'Проекты', href: '/ru/projects/ecosystem/', active: stripped.startsWith('/projects') },
			{ label: 'Расчёт', href: '/ru/calculator/', active: stripped.startsWith('/calculator') },
			{ label: 'Обо мне', href: '/ru/about/', active: stripped.startsWith('/about') },
			{
				label: 'Блог',
				href: '/ru/blog/',
				active: stripped.startsWith('/blog') || stripped.startsWith('/guides') || stripped.startsWith('/reference'),
			},
		],
	},
}[lang];

const navTabs = copy.tabs;
---

<div class="vsl-header-row">
	<div class="vsl-header-left">
		{shouldRenderSearch && <Search />}
	</div>

	<nav class="vsl-header-tabs" aria-label={copy.mainNav}>
		{navTabs.map((tab) => (
			<a href={tab.href} class={`vsl-tab-link ${tab.active ? 'is-active' : ''}`}>
				{tab.label}
			</a>
		))}
	</nav>

	<div class="vsl-header-right">
		<div class="vsl-lang-switch" role="group" aria-label={copy.language}>
			<a href={enPath} class={`vsl-lang-btn ${lang === 'en' ? 'is-active' : ''}`} hreflang="en">EN</a>
			<a href={roPath} class={`vsl-lang-btn ${lang === 'ro' ? 'is-active' : ''}`} hreflang="ro">RO</a>
			<a href={ruPath} class={`vsl-lang-btn ${lang === 'ru' ? 'is-active' : ''}`} hreflang="ru">RU</a>
		</div>

		<button
			type="button"
			id="vsl-notif-btn"
			class="vsl-bell-btn"
			title={copy.ecoStatus}
			aria-label={copy.ecoStatus}
			aria-expanded="false"
		>
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
				<path d="M13.73 21a2 2 0 0 1-3.46 0" />
			</svg>
			<span class="vsl-online-dot" aria-hidden="true"></span>
		</button>

		<button
			type="button"
			id="vsl-profile-btn"
			class="vsl-profile-btn"
			aria-expanded="false"
			aria-label={copy.profileAria}
		>
			<span class="vsl-avatar" aria-hidden="true">iD</span>
			<span class="vsl-profile-meta">
				<span class="vsl-profile-name">iDominiqe</span>
				<span class="vsl-profile-sub">{copy.liveNodes}</span>
			</span>
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="opacity:0.65;">
				<polyline points="6 9 12 15 18 9" />
			</svg>
		</button>

		<!-- Status / Updates Popover -->
		<div id="vsl-notif-popover" class="vsl-popover" role="region" aria-label={copy.liveTel}>
			<div class="vsl-popover-title">{copy.edgeTel}</div>
			<a href={`${prefix}/projects/ecosystem/`} class="vsl-popover-item">
				<span>{copy.subRepos}</span>
				<span class="vsl-popover-muted" style="color:#22c55e;">● Online</span>
			</a>
			<a href={`${prefix}/blog/dns-ns-domains/`} class="vsl-popover-item">
				<span>DNS · Cloudflare Anycast</span>
				<span class="vsl-popover-muted">TLS 1.3</span>
			</a>
			<a href={`${prefix}/reference/architecture/`} class="vsl-popover-item">
				<span>Starlight + Pagefind</span>
				<span class="vsl-popover-muted">{copy.ready}</span>
			</a>
			<button type="button" id="vsl-popover-open-themes" class="vsl-popover-item">
				<span>{copy.customThemes}</span>
				<span class="vsl-popover-muted">{copy.presets}</span>
			</button>
		</div>

		<!-- Profile & Social Links Popover -->
		<div id="vsl-profile-popover" class="vsl-popover" role="region" aria-label={copy.devChannels}>
			<div class="vsl-popover-title">{copy.ecoHubs}</div>
			<a href={`${prefix}/about/`} class="vsl-popover-item">
				<span>{copy.aboutMe}</span>
				<span class="vsl-popover-muted">Bio · Hardware</span>
			</a>
			<a href={`${prefix}/calculator/`} class="vsl-popover-item">
				<span>{copy.calculator}</span>
				<span class="vsl-popover-muted">Web · App · MCU</span>
			</a>
			<a href={`${prefix}/guides/getting-started/`} class="vsl-popover-item">
				<span>{copy.guidesLink}</span>
				<span class="vsl-popover-muted">{copy.presets}</span>
			</a>
			<a href="https://portfolio.idominiqe.com/" target="_blank" rel="noopener noreferrer" class="vsl-popover-item">
				<span>VisionOS Portfolio</span>
				<span class="vsl-popover-muted">portfolio.idominiqe.com ↗</span>
			</a>
			<a href="https://v-2.idominiqe.com/" target="_blank" rel="noopener noreferrer" class="vsl-popover-item">
				<span>Liquid Glass v-2 Archive</span>
				<span class="vsl-popover-muted">v-2.idominiqe.com ↗</span>
			</a>
			<div class="vsl-popover-title" style="margin-top:6px;">{copy.channels}</div>
			{SOCIALS.map((s) => (
				<a href={s.href} target="_blank" rel="noopener noreferrer" class="vsl-popover-item">
					<span>{s.label}</span>
					<span class="vsl-popover-muted">{s.handle} ↗</span>
				</a>
			))}
		</div>
	</div>
</div>

<script is:inline>
	(function () {
		const bellBtn = document.getElementById('vsl-notif-btn');
		const profBtn = document.getElementById('vsl-profile-btn');
		const bellPop = document.getElementById('vsl-notif-popover');
		const profPop = document.getElementById('vsl-profile-popover');

		const closeAll = () => {
			bellPop?.classList.remove('is-open');
			profPop?.classList.remove('is-open');
			bellBtn?.setAttribute('aria-expanded', 'false');
			profBtn?.setAttribute('aria-expanded', 'false');
		};

		bellBtn?.addEventListener('click', (e) => {
			e.stopPropagation();
			const next = !bellPop?.classList.contains('is-open');
			closeAll();
			if (next && bellPop) {
				bellPop.classList.add('is-open');
				bellBtn.setAttribute('aria-expanded', 'true');
			}
		});

		profBtn?.addEventListener('click', (e) => {
			e.stopPropagation();
			const next = !profPop?.classList.contains('is-open');
			closeAll();
			if (next && profPop) {
				profPop.classList.add('is-open');
				profBtn.setAttribute('aria-expanded', 'true');
			}
		});

		document.getElementById('vsl-popover-open-themes')?.addEventListener('click', () => {
			closeAll();
			document.getElementById('vsl-theme-open')?.click();
		});

		document.addEventListener('click', (e) => {
			if (!(e.target instanceof Element)) return;
			if (!e.target.closest('.vsl-header-right')) closeAll();
		});
	})();
</script>
