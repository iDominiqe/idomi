---
import Default from '@astrojs/starlight/components/PageTitle.astro';

const p = Astro.url.pathname;
const stripped = p.replace(/^\/(ro|ru)(?=\/|$)/, '') || '/';
const isSplashHome =
	stripped === '/' ||
	stripped === '/about' ||
	stripped === '/about/' ||
	stripped === '/calculator' ||
	stripped === '/calculator/' ||
	stripped.startsWith('/projects/ecosystem');
---

{!isSplashHome && <Default />}
