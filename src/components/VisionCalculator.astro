---

<div class="vsl-calc-page not-content" id="vsl-calculator">
	<header class="vsl-doc-card vsl-calc-hero" data-tile="1">
		<div class="vsl-calc-eyebrow">{copy.eyebrow}</div>
		<h1 class="vsl-calc-h1">{copy.title}</h1>
		<p class="vsl-calc-sub">{copy.subtitle}</p>
	</header>

	<div class="vsl-calc-grid">
		<div class="vsl-calc-controls">
			<section class="vsl-doc-card vsl-calc-block" data-tile="2">
				<h2 class="vsl-calc-h2">{copy.step1}</h2>
				<div class="vsl-calc-types" role="radiogroup" aria-label={copy.step1}>
					{copy.types.map((t, idx) => (
						<button
							type="button"
							role="radio"
							aria-checked={idx === 0 ? 'true' : 'false'}
							class={`vsl-calc-type-card ${idx === 0 ? 'is-selected' : ''}`}
							data-calc-type={t.id}
							data-title={t.title}
							data-min={t.min}
							data-max={t.max}
							data-days-min={t.daysMin}
							data-days-max={t.daysMax}
						>
							<span class="vsl-calc-type-top">
								<strong>{t.title}</strong>
								<span class={`vsl-calc-badge is-${t.tone}`}>{t.badge}</span>
							</span>
							<span class="vsl-calc-type-desc">{t.desc}</span>
						</button>
					))}
				</div>
			</section>

			<section class="vsl-doc-card vsl-calc-block" data-tile="3">
				<h2 class="vsl-calc-h2">{copy.step2}</h2>
				<div class="vsl-calc-addons">
					{copy.addons.map((a) => (
						<label class="vsl-calc-addon">
							<input
								type="checkbox"
								data-calc-addon={a.id}
								data-title={a.title}
								data-add-min={a.min}
								data-add-max={a.max}
								data-add-days={a.days}
							/>
							<span class="vsl-calc-addon-title">{a.title}</span>
							<span class="vsl-calc-addon-price" data-base-min={a.min} data-base-max={a.max}>
								+€{a.min}–€{a.max}
							</span>
						</label>
					))}
				</div>
			</section>

			<section class="vsl-doc-card vsl-calc-block" data-tile="4">
				<h2 class="vsl-calc-h2">{copy.step3}</h2>
				<div class="vsl-calc-scales" role="group" aria-label={copy.step3}>
					{copy.scales.map((s) => (
						<button
							type="button"
							class={`vsl-calc-scale-btn ${s.id === 'std' ? 'is-selected' : ''}`}
							data-calc-scale={s.id}
							data-mult={s.mult}
						>
							{s.label}
						</button>
					))}
				</div>

				<label class="vsl-calc-partner">
					<input type="checkbox" id="vsl-calc-partner" />
					<span>{copy.partnerLabel}</span>
				</label>
			</section>
		</div>

		<aside class="vsl-doc-card vsl-calc-summary-card" data-tile="5">
			<div class="vsl-calc-sum-head">
				<span class="vsl-calc-sum-label">{copy.estimateTitle}</span>
				<div class="vsl-calc-curr" role="group" aria-label="Currency">
					<button type="button" class="vsl-curr-btn is-active" data-curr="EUR">EUR</button>
					<button type="button" class="vsl-curr-btn" data-curr="USD">USD</button>
					<button type="button" class="vsl-curr-btn" data-curr="MDL">MDL</button>
				</div>
			</div>

			<div class="vsl-calc-price" id="vsl-calc-price">€70 – €150</div>
			<div class="vsl-calc-days">
				<span>{copy.timelineLabel}:</span>
				<strong id="vsl-calc-days">3–7 {copy.daysWord}</strong>
			</div>

			<div class="vsl-calc-tags" id="vsl-calc-summary"></div>

			<div class="vsl-calc-callout is-warn" id="vsl-calc-apple-note" hidden>
				{copy.appleWarn}
			</div>
			<div class="vsl-calc-callout is-tech" id="vsl-calc-hw-note" hidden>
				{copy.hwWarn}
			</div>

			<p class="vsl-calc-fair">{copy.fairNote}</p>

			<form class="vsl-calc-form" id="vsl-calc-form">
				<input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" hidden />
				<input
					id="vsl-calc-contact"
					class="vsl-calc-input"
					type="text"
					maxlength="48"
					placeholder={copy.contactPlaceholder}
					aria-label={copy.contactPlaceholder}
				/>
				<textarea
					id="vsl-calc-note"
					class="vsl-calc-textarea"
					rows="3"
					maxlength="360"
					placeholder={copy.notePlaceholder}
					aria-label={copy.notePlaceholder}
				></textarea>
				<button type="submit" id="vsl-calc-submit" class="vsl-btn-white vsl-calc-submit">
					{copy.submitBtn}
				</button>
			</form>

			<div class="vsl-calc-status" id="vsl-calc-status" role="status" aria-live="polite" hidden></div>

			<div class="vsl-calc-links">
				<a href={`${prefix}/about/`}>{copy.aboutLink}</a>
				<a href={`${prefix}/#vsl-chat-card`}>{copy.homeChatLink}</a>
			</div>
		</aside>
	</div>
</div>

<script
	define:vars={{
		langCode: lang,
		daysWord: copy.daysWord,
		submitBtnText: copy.submitBtn,
		sendingBtnText: copy.sendingBtn,
		sentOkText: copy.sentOk,
		sentQueueText: copy.sentQueue,
		sendErrText: copy.sendErr,
		partnerShort: copy.partnerLabel,
	}}
>
	(function () {
		const RATES = {
			EUR: { symbol: '€', mult: 1, step: 5, suffix: '' },
			USD: { symbol: '$', mult: 1.08, step: 5, suffix: '' },
			MDL: { symbol: '', mult: 19.5, step: 50, suffix: ' L' },
		};

		let currentCurr = 'EUR';
		let selectedTypeBtn = document.querySelector('[data-calc-type].is-selected');
		let selectedScaleBtn = document.querySelector('[data-calc-scale].is-selected');
		const partnerCheck = document.getElementById('vsl-calc-partner');

		const priceEl = document.getElementById('vsl-calc-price');
		const daysEl = document.getElementById('vsl-calc-days');
		const summaryEl = document.getElementById('vsl-calc-summary');
		const appleNote = document.getElementById('vsl-calc-apple-note');
		const hwNote = document.getElementById('vsl-calc-hw-note');

		const fmtMoney = (eurAmount) => {
			const cfg = RATES[currentCurr] || RATES.EUR;
			const raw = eurAmount * cfg.mult;
			const rounded = Math.round(raw / cfg.step) * cfg.step;
			return `${cfg.symbol}${rounded}${cfg.suffix}`;
		};

		function recalculate() {
			if (!selectedTypeBtn) return;
			const baseMin = Number(selectedTypeBtn.getAttribute('data-min') || 70);
			const baseMax = Number(selectedTypeBtn.getAttribute('data-max') || 150);
			const baseDaysMin = Number(selectedTypeBtn.getAttribute('data-days-min') || 3);
			const baseDaysMax = Number(selectedTypeBtn.getAttribute('data-days-max') || 7);
			const typeId = selectedTypeBtn.getAttribute('data-calc-type') || 'web';
			const typeTitle = selectedTypeBtn.getAttribute('data-title') || typeId;

			let addMin = 0;
			let addMax = 0;
			let addDays = 0;
			const chosenAddons = [];

			document.querySelectorAll('[data-calc-addon]').forEach((el) => {
				if (!(el instanceof HTMLInputElement)) return;
				if (el.checked) {
					addMin += Number(el.getAttribute('data-add-min') || 0);
					addMax += Number(el.getAttribute('data-add-max') || 0);
					addDays += Number(el.getAttribute('data-add-days') || 0);
					chosenAddons.push(el.getAttribute('data-title') || '');
				}
			});

			const scaleMult = Number(selectedScaleBtn?.getAttribute('data-mult') || 1);
			const scaleLabel = selectedScaleBtn?.textContent?.trim() || 'Standard';
			const isPartner = partnerCheck instanceof HTMLInputElement && partnerCheck.checked;
			const discountMult = isPartner ? 0.85 : 1;

			const totalMin = (baseMin + addMin) * scaleMult * discountMult;
			const totalMax = (baseMax + addMax) * scaleMult * discountMult;
			const daysMin = Math.max(2, Math.round((baseDaysMin + addDays * 0.7) * (scaleMult > 1 ? 1.15 : 1)));
			const daysMax = Math.max(daysMin + 2, Math.round((baseDaysMax + addDays) * (scaleMult > 1 ? 1.2 : 1)));

			if (priceEl) priceEl.textContent = `${fmtMoney(totalMin)} – ${fmtMoney(totalMax)}`;
			if (daysEl) daysEl.textContent = `${daysMin}–${daysMax} ${daysWord}`;

			document.querySelectorAll('.vsl-calc-addon-price').forEach((span) => {
				const bMin = Number(span.getAttribute('data-base-min') || 0);
				const bMax = Number(span.getAttribute('data-base-max') || 0);
				span.textContent = `+${fmtMoney(bMin)}–${fmtMoney(bMax)}`;
			});

			if (appleNote) appleNote.hidden = typeId !== 'apple';
			if (hwNote) hwNote.hidden = typeId !== 'hardware';

			if (summaryEl) {
				summaryEl.replaceChildren();
				const pills = [typeTitle, scaleLabel, ...chosenAddons];
				if (isPartner) pills.push('-15%');
				pills.forEach((txt) => {
					const chip = document.createElement('span');
					chip.className = 'vsl-calc-tag';
					chip.textContent = txt;
					summaryEl.appendChild(chip);
				});
			}

			return {
				typeTitle,
				scaleLabel,
				chosenAddons,
				isPartner,
				estimate: `${fmtMoney(totalMin)} – ${fmtMoney(totalMax)}`,
				timeline: `${daysMin}–${daysMax} ${daysWord}`,
			};
		}

		document.querySelectorAll('[data-calc-type]').forEach((btn) => {
			btn.addEventListener('click', () => {
				document.querySelectorAll('[data-calc-type]').forEach((b) => {
					b.classList.remove('is-selected');
					b.setAttribute('aria-checked', 'false');
				});
				btn.classList.add('is-selected');
				btn.setAttribute('aria-checked', 'true');
				selectedTypeBtn = btn;
				recalculate();
			});
		});

		document.querySelectorAll('[data-calc-addon]').forEach((chk) => {
			chk.addEventListener('change', recalculate);
		});

		document.querySelectorAll('[data-calc-scale]').forEach((btn) => {
			btn.addEventListener('click', () => {
				document.querySelectorAll('[data-calc-scale]').forEach((b) => b.classList.remove('is-selected'));
				btn.classList.add('is-selected');
				selectedScaleBtn = btn;
				recalculate();
			});
		});

		partnerCheck?.addEventListener('change', recalculate);

		document.querySelectorAll('[data-curr]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const c = btn.getAttribute('data-curr') || 'EUR';
				if (!RATES[c]) return;
				currentCurr = c;
				document.querySelectorAll('[data-curr]').forEach((b) => b.classList.toggle('is-active', b === btn));
				recalculate();
			});
		});

		const form = document.getElementById('vsl-calc-form');
		const contactEl = document.getElementById('vsl-calc-contact');
		const noteEl = document.getElementById('vsl-calc-note');
		const submitBtn = document.getElementById('vsl-calc-submit');
		const statusEl = document.getElementById('vsl-calc-status');

		const isLocalHost = window.location.hostname === '127.0.0.1' || window.location.hostname === 'localhost';
		const CHAT_API = isLocalHost ? 'https://idominiqe.com/api/chat' : '/api/chat';
		const CHAT_SESSION_KEY = 'vslChatSession';

		form?.addEventListener('submit', async (e) => {
			e.preventDefault();
			const snap = recalculate();
			if (!snap) return;

			const contact = contactEl instanceof HTMLInputElement ? contactEl.value.trim() : '';
			const note = noteEl instanceof HTMLTextAreaElement ? noteEl.value.trim() : '';
			const honeyInput = form.querySelector('input[name="website"]');
			const website = honeyInput instanceof HTMLInputElement ? honeyInput.value : '';

			const addonsText = snap.chosenAddons.length > 0 ? snap.chosenAddons.join(', ') : 'None';
			const prefixTag = langCode === 'ru' ? '[Калькулятор]' : '[Calculator]';
			const summaryMsg = [
				`${prefixTag} ${snap.typeTitle} (${snap.scaleLabel}${snap.isPartner ? ', -15% partner' : ''})`,
				`Budget: ${snap.estimate} | Timeline: ${snap.timeline}`,
				`Modules: ${addonsText}`,
				note ? `Note: ${note}` : '',
			]
				.filter(Boolean)
				.join('\n')
				.slice(0, 780);

			let existing = { sessionId: '', sessionToken: '', messages: [] };
			try {
				const raw = localStorage.getItem(CHAT_SESSION_KEY);
				if (raw) existing = JSON.parse(raw);
			} catch (_) {}

			if (submitBtn instanceof HTMLButtonElement) {
				submitBtn.disabled = true;
				submitBtn.textContent = sendingBtnText;
			}
			if (statusEl) {
				statusEl.hidden = true;
				statusEl.classList.remove('is-error');
			}

			try {
				const res = await fetch(`${CHAT_API}/send`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						name: contact || 'Calculator Visitor',
						text: summaryMsg,
						lang: langCode,
						website,
						sessionId: existing.sessionId || undefined,
						sessionToken: existing.sessionToken || undefined,
					}),
				});
				const data = await res.json().catch(() => null);
				if (!res.ok || !data?.ok) {
					throw new Error(data?.error || sendErrText);
				}

				try {
					localStorage.setItem(
						CHAT_SESSION_KEY,
						JSON.stringify({
							sessionId: data.sessionId,
							sessionToken: data.sessionToken,
							messages: data.messages || [],
						})
					);
				} catch (_) {}

				if (noteEl instanceof HTMLTextAreaElement) noteEl.value = '';
				if (statusEl) {
					statusEl.hidden = false;
					statusEl.textContent = data.delivered ? sentOkText : sentQueueText;
				}
				window.__vslToast?.(data.delivered ? sentOkText : sentQueueText);
			} catch (err) {
				if (statusEl) {
					statusEl.hidden = false;
					statusEl.classList.add('is-error');
					statusEl.textContent = err instanceof Error ? err.message : sendErrText;
				}
				window.__vslToast?.(sendErrText);
			} finally {
				if (submitBtn instanceof HTMLButtonElement) {
					submitBtn.disabled = false;
					submitBtn.textContent = submitBtnText;
				}
			}
		});

		recalculate();
	})();
</script>

