<script
	define:vars={{
		langCode: lang,
		copyStrings: {
			maskBtn: copy.maskBtn,
			unmaskBtn: copy.unmaskBtn,
			copiedOk: copy.copiedOk,
			copiedIp: copy.copiedIp,
			refreshed: copy.refreshed,
			unavailable: copy.unavailable,
			yes: copy.yes,
			no: copy.no,
			online: copy.online,
			offline: copy.offline,
			charging: copy.charging,
			discharging: copy.discharging,
			localeTag: copy.localeTag,
			macMasked: copy.macMasked,
		},
	}}
>
	(function () {
		const isLocalHost = window.location.hostname === '127.0.0.1' || window.location.hostname === 'localhost';
		const SYSINFO_API = isLocalHost ? 'https://idominiqe.com/api/chat/sysinfo' : '/api/chat/sysinfo';
		const pageEl = document.getElementById('vsl-system-page');
		const maskBtn = document.getElementById('vsl-sys-mask-btn');
		const refreshBtn = document.getElementById('vsl-sys-refresh-btn');
		const copyJsonBtn = document.getElementById('vsl-sys-copy-btn');
		const copyIpBtn = document.getElementById('vsl-sys-copy-ip');

		const snapshot = {
			generatedAt: new Date().toISOString(),
			network: {},
			edge: {},
			system: {},
			graphics: {},
			display: {},
			browser: {},
		};

		const setTxt = (id, val) => {
			const el = document.getElementById(id);
			if (el) el.textContent = val || copyStrings.unavailable;
		};

		function formatBytes(bytes) {
			if (!Number.isFinite(bytes) || bytes <= 0) return copyStrings.unavailable;
			const gb = bytes / (1024 * 1024 * 1024);
			if (gb >= 1) return `${gb.toFixed(1)} GB`;
			const mb = bytes / (1024 * 1024);
			return `${Math.round(mb)} MB`;
		}

		function formatCountryName(code) {
			if (!code) return '';
			try {
				const dn = new Intl.DisplayNames([copyStrings.localeTag, 'en'], { type: 'region' });
				return `${dn.of(code)} (${code})`;
			} catch (_) {
				return code;
			}
		}

		function parseUserAgentFallback() {
			const ua = navigator.userAgent || '';
			let os = navigator.platform || 'Unknown OS';
			if (/Windows NT 10\.0/.test(ua)) os = 'Windows 10 / 11';
			else if (/Mac OS X ([\d_]+)/.test(ua)) os = `macOS ${RegExp.$1.replace(/_/g, '.')}`;
			else if (/Android ([\d.]+)/.test(ua)) os = `Android ${RegExp.$1}`;
			else if (/iPhone OS ([\d_]+)|CPU OS ([\d_]+)/.test(ua)) os = `iOS ${(RegExp.$1 || RegExp.$2).replace(/_/g, '.')}`;
			else if (/Linux/.test(ua)) os = 'Linux';

			let browser = 'Browser';
			if (/Edg\/([\d.]+)/.test(ua)) browser = `Microsoft Edge ${RegExp.$1}`;
			else if (/OPR\/([\d.]+)/.test(ua)) browser = `Opera ${RegExp.$1}`;
			else if (/Chrome\/([\d.]+)/.test(ua)) browser = `Chromium / Chrome ${RegExp.$1}`;
			else if (/Firefox\/([\d.]+)/.test(ua)) browser = `Firefox ${RegExp.$1}`;
			else if (/Version\/([\d.]+).*Safari/.test(ua)) browser = `Safari ${RegExp.$1}`;

			let arch = /x86_64|Win64|WOW64|amd64/i.test(ua)
				? 'x86_64 (64-bit)'
				: /arm64|aarch64/i.test(ua)
					? 'ARM64 (64-bit)'
					: navigator.platform || 'Unknown';

			return { os, browser, arch };
		}

		async function collectOsAndBrowser() {
			const fb = parseUserAgentFallback();
			let osLabel = fb.os;
			let archLabel = fb.arch;
			let browserLabel = fb.browser;

			try {
				const uad = navigator.userAgentData;
				if (uad && typeof uad.getHighEntropyValues === 'function') {
					const hi = await uad.getHighEntropyValues(['platform', 'platformVersion', 'architecture', 'bitness', 'fullVersionList']);
					if (hi.platform === 'Windows' && hi.platformVersion) {
						const major = parseInt(String(hi.platformVersion).split('.')[0] || '0', 10);
						osLabel = major >= 13 ? `Windows 11 (NT ${hi.platformVersion})` : `Windows 10 (NT ${hi.platformVersion})`;
					} else if (hi.platform) {
						osLabel = hi.platformVersion ? `${hi.platform} ${hi.platformVersion}` : hi.platform;
					}
					if (hi.architecture) {
						archLabel = hi.bitness ? `${hi.architecture} (${hi.bitness}-bit)` : hi.architecture;
					}
					const brandList = Array.isArray(hi.fullVersionList) ? hi.fullVersionList : uad.brands;
					const meaningful = (brandList || []).find((b) => b.brand && !/Not.?A.?Brand/i.test(b.brand));
					if (meaningful) {
						browserLabel = `${meaningful.brand} ${meaningful.version}`;
					}
				}
			} catch (_) {}

			const cores = navigator.hardwareConcurrency ? `${navigator.hardwareConcurrency} threads` : copyStrings.unavailable;
			const ram = navigator.deviceMemory ? `~${navigator.deviceMemory} GB+` : copyStrings.unavailable;
			let localTz = copyStrings.unavailable;
			try {
				const tzName = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
				const timeStr = new Intl.DateTimeFormat(copyStrings.localeTag, { hour: '2-digit', minute: '2-digit', second: '2-digit' }).format(new Date());
				localTz = `${timeStr} (${tzName})`;
			} catch (_) {}

			setTxt('sys-os', osLabel);
			setTxt('sys-kpi-os', osLabel);
			setTxt('sys-arch', archLabel);
			setTxt('sys-cores', cores);
			setTxt('sys-ram', ram);
			setTxt('sys-localtime', localTz);
			setTxt('sys-browser', browserLabel);
			setTxt('sys-langs', (navigator.languages || [navigator.language]).filter(Boolean).join(', '));

			snapshot.system = { os: osLabel, arch: archLabel, threads: navigator.hardwareConcurrency || null, memoryGb: navigator.deviceMemory || null, localTime: localTz };
			snapshot.browser = { browser: browserLabel, languages: navigator.languages || [] };
		}

		function collectGpu() {
			let renderer = copyStrings.unavailable;
			let vendor = copyStrings.unavailable;
			let webglVer = copyStrings.no;
			let limits = copyStrings.unavailable;

			try {
				const canvas = document.createElement('canvas');
				canvas.width = 1;
				canvas.height = 1;
				const gl2 = canvas.getContext('webgl2');
				const gl = gl2 || canvas.getContext('webgl');
				if (gl) {
					webglVer = gl2 ? 'WebGL 2.0 + 1.0' : 'WebGL 1.0';
					const dbg = gl.getExtension('WEBGL_debug_renderer_info');
					if (dbg) {
						renderer = gl.getParameter(dbg.UNMASKED_RENDERER_WEBGL) || gl.getParameter(gl.RENDERER) || renderer;
						vendor = gl.getParameter(dbg.UNMASKED_VENDOR_WEBGL) || gl.getParameter(gl.VENDOR) || vendor;
					} else {
						renderer = gl.getParameter(gl.RENDERER) || renderer;
						vendor = gl.getParameter(gl.VENDOR) || vendor;
					}
					const maxTex = gl.getParameter(gl.MAX_TEXTURE_SIZE);
					const maxVp = gl.getParameter(gl.MAX_VIEWPORT_DIMS);
					limits = `${maxTex}px / ${maxVp ? maxVp[0] + '×' + maxVp[1] : '?'}`;
				}
			} catch (_) {}

			const webgpu = 'gpu' in navigator ? copyStrings.yes : copyStrings.no;
			setTxt('sys-gpu', renderer);
			setTxt('sys-kpi-gpu', renderer.length > 36 ? renderer.slice(0, 36) + '…' : renderer);
			setTxt('sys-gpu-vendor', vendor);
			setTxt('sys-webgl', webglVer);
			setTxt('sys-maxtex', limits);
			setTxt('sys-webgpu', webgpu);

			snapshot.graphics = { renderer, vendor, webgl: webglVer, limits, webgpu: 'gpu' in navigator };
		}

		function updateViewportMetrics() {
			const dpr = Number(window.devicePixelRatio || 1);
			const sw = window.screen?.width || 0;
			const sh = window.screen?.height || 0;
			const pw = Math.round(sw * dpr);
			const ph = Math.round(sh * dpr);
			const vw = window.innerWidth;
			const vh = window.innerHeight;
			const orient = window.screen?.orientation?.type ? ` (${window.screen.orientation.type.replace('-primary', '')})` : '';

			const p3 = window.matchMedia?.('(color-gamut: p3)').matches ? 'Display-P3' : 'sRGB';
			const hdr = window.matchMedia?.('(dynamic-range: high)').matches ? 'HDR' : 'SDR';
			const prefDark = window.matchMedia?.('(prefers-color-scheme: dark)').matches ? 'Dark' : 'Light';
			const touchPts = navigator.maxTouchPoints || 0;

			setTxt('sys-screen', `${sw} × ${sh}${orient}`);
			setTxt('sys-physical', `${pw} × ${ph}`);
			setTxt('sys-viewport', `${vw} × ${vh}`);
			setTxt('sys-dpr', `${dpr.toFixed(2)}x (${Math.round(dpr * 96)} DPI)`);
			setTxt('sys-color', `${window.screen?.colorDepth || 24}-bit · ${p3}`);
			setTxt('sys-hdr', `${hdr} · OS ${prefDark}`);
			setTxt('sys-touch', touchPts > 0 ? `${touchPts} points` : 'Desktop / Non-touch');

			snapshot.display = {
				...snapshot.display,
				logical: `${sw}x${sh}`,
				physical: `${pw}x${ph}`,
				viewport: `${vw}x${vh}`,
				dpr,
				gamut: p3,
				hdr,
				touchPoints: touchPts,
			};
		}

		function measureRefreshRate() {
			const samples = [];
			let last = performance.now();
			const step = (now) => {
				const dt = now - last;
				last = now;
				if (dt > 1 && dt < 100) samples.push(1000 / dt);
				if (samples.length < 24) {
					requestAnimationFrame(step);
					return;
				}
				samples.sort((a, b) => a - b);
				const median = samples[Math.floor(samples.length / 2)] || 60;
				const standard = [60, 75, 90, 120, 144, 165, 240];
				const nearest = standard.find((r) => Math.abs(r - median) <= 4);
				const hzText = `${nearest || Math.round(median)} Hz`;
				setTxt('sys-hz', hzText);
				snapshot.display.refreshRate = hzText;
			};
			requestAnimationFrame(step);
		}

		function collectConnectionAndEnv() {
			const conn = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
			setTxt('sys-conntype', conn?.effectiveType ? `${conn.effectiveType.toUpperCase()}${conn.type ? ' · ' + conn.type : ''}` : copyStrings.unavailable);
			setTxt('sys-downlink', conn?.downlink ? `~${conn.downlink} Mbps${conn.rtt ? ' / ' + conn.rtt + ' ms' : ''}` : copyStrings.unavailable);
			setTxt('sys-online', navigator.onLine ? copyStrings.online : copyStrings.offline);

			const flags = [
				typeof WebAssembly === 'object' ? 'WASM' : null,
				'serviceWorker' in navigator ? 'SW' : null,
				navigator.cookieEnabled ? 'Cookies' : null,
				navigator.doNotTrack === '1' ? 'DNT=1' : 'DNT=off',
			]
				.filter(Boolean)
				.join(' · ');
			setTxt('sys-flags', flags);

			if (typeof navigator.getBattery === 'function') {
				navigator
					.getBattery()
					.then((bat) => {
						const pct = `${Math.round((bat.level || 0) * 100)}%`;
						const state = bat.charging ? copyStrings.charging : copyStrings.discharging;
						setTxt('sys-battery', `${pct} (${state})`);
						snapshot.browser.battery = `${pct} (${state})`;
					})
					.catch(() => setTxt('sys-battery', copyStrings.unavailable));
			} else {
				setTxt('sys-battery', copyStrings.unavailable);
			}

			if (navigator.storage?.estimate) {
				navigator.storage
					.estimate()
					.then((est) => {
						const txt = `${formatBytes(est.usage || 0)} / ${formatBytes(est.quota || 0)}`;
						setTxt('sys-storage', txt);
						snapshot.browser.storage = txt;
					})
					.catch(() => setTxt('sys-storage', copyStrings.unavailable));
			} else {
				setTxt('sys-storage', copyStrings.unavailable);
			}

			if (navigator.mediaDevices?.enumerateDevices) {
				navigator.mediaDevices
					.enumerateDevices()
					.then((devs) => {
						const mics = devs.filter((d) => d.kind === 'audioinput').length;
						const cams = devs.filter((d) => d.kind === 'videoinput').length;
						const spk = devs.filter((d) => d.kind === 'audiooutput').length;
						const label = `Mic: ${mics} · Cam: ${cams} · Audio Out: ${spk}`;
						setTxt('sys-media', label);
						snapshot.browser.media = { mics, cams, spk };
					})
					.catch(() => setTxt('sys-media', copyStrings.unavailable));
			} else {
				setTxt('sys-media', copyStrings.unavailable);
			}
		}

		async function fetchEdgeTelemetry() {
			const t0 = performance.now();
			try {
				const res = await fetch(`${SYSINFO_API}?_t=${Date.now()}`, { cache: 'no-store' });
				const rtt = Math.max(1, Math.round(performance.now() - t0));
				if (!res.ok) throw new Error('HTTP ' + res.status);
				const data = await res.json();
				if (!data?.ok) throw new Error('Bad payload');

				const countryFull = formatCountryName(data.country);
				const cityLine = [data.city, data.region].filter(Boolean).join(', ') || copyStrings.unavailable;
				const ispName = data.isp || copyStrings.unavailable;
				const asnLabel = data.asn ? `AS${data.asn}` : '—';
				const coords = data.latitude && data.longitude ? `${data.latitude}, ${data.longitude}` : copyStrings.unavailable;

				setTxt('sys-kpi-ip', data.ip || copyStrings.unavailable);
				setTxt('sys-kpi-ip-sub', `${data.ipVersion || 'IP'} · ${copyStrings.macMasked.split(' ')[0]}`);
				setTxt('sys-kpi-isp', ispName);
				setTxt('sys-kpi-asn', asnLabel);
				setTxt('sys-kpi-geo', [data.city, data.country].filter(Boolean).join(', ') || countryFull || copyStrings.unavailable);
				setTxt('sys-kpi-ping', `Cloudflare ${data.colo || 'Edge'} · ${rtt} ms`);

				setTxt('sys-ip', data.ip || copyStrings.unavailable);
				setTxt('sys-ipver', data.ipVersion || copyStrings.unavailable);
				setTxt('sys-isp', ispName);
				setTxt('sys-asn', asnLabel);
				setTxt('sys-country', countryFull || copyStrings.unavailable);
				setTxt('sys-city', cityLine);
				setTxt('sys-tz', data.timezone || copyStrings.unavailable);
				setTxt('sys-coords', coords);

				setTxt('sys-colo', data.colo ? `${data.colo} (Anycast)` : copyStrings.unavailable);
				setTxt('sys-ping', `${rtt} ms`);
				setTxt('sys-tls', [data.httpProtocol, data.tlsVersion, data.tlsCipher].filter(Boolean).join(' · ') || copyStrings.unavailable);

				snapshot.network = {
					ip: data.ip,
					ipVersion: data.ipVersion,
					mac: 'Masked at L2/Browser',
					isp: ispName,
					asn: asnLabel,
					country: countryFull,
					city: cityLine,
					timezone: data.timezone,
					coords,
				};
				snapshot.edge = {
					colo: data.colo,
					rttMs: rtt,
					httpProtocol: data.httpProtocol,
					tlsVersion: data.tlsVersion,
					tlsCipher: data.tlsCipher,
				};
			} catch (_) {
				setTxt('sys-kpi-ip', copyStrings.unavailable);
				setTxt('sys-kpi-ping', 'Edge telemetry unreachable');
			}
		}

		maskBtn?.addEventListener('click', () => {
			const next = !pageEl?.classList.contains('is-masked');
			pageEl?.classList.toggle('is-masked', next);
			maskBtn.setAttribute('aria-pressed', next ? 'true' : 'false');
			maskBtn.textContent = next ? copyStrings.unmaskBtn : copyStrings.maskBtn;
		});

		copyIpBtn?.addEventListener('click', async () => {
			const ip = snapshot.network?.ip;
			if (!ip) return;
			try {
				await navigator.clipboard.writeText(ip);
				window.__vslToast?.(copyStrings.copiedIp);
			} catch (_) {}
		});

		copyJsonBtn?.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(JSON.stringify(snapshot, null, 2));
				window.__vslToast?.(copyStrings.copiedOk);
			} catch (_) {}
		});

		refreshBtn?.addEventListener('click', async () => {
			await Promise.all([fetchEdgeTelemetry(), collectOsAndBrowser()]);
			collectGpu();
			updateViewportMetrics();
			collectConnectionAndEnv();
			measureRefreshRate();
			window.__vslToast?.(copyStrings.refreshed);
		});

		window.addEventListener('resize', updateViewportMetrics);

		fetchEdgeTelemetry();
		collectOsAndBrowser();
		collectGpu();
		updateViewportMetrics();
		collectConnectionAndEnv();
		measureRefreshRate();
	})();
</script>

