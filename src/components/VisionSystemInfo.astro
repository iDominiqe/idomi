				<div><dt>{copy.lMaxTex}</dt><dd id="sys-maxtex">—</dd></div>
				<div><dt>{copy.lWebgpu}</dt><dd id="sys-webgpu">—</dd></div>
			</dl>
		</article>

		<!-- 5. Display, Refresh Rate & Input -->
		<article class="vsl-doc-card vsl-sys-card">
			<h2 class="vsl-sys-h2">🖥️ {copy.c5Title}</h2>
			<dl class="vsl-sys-dl">
				<div><dt>{copy.lScreen}</dt><dd id="sys-screen">—</dd></div>
				<div><dt>{copy.lPhysical}</dt><dd id="sys-physical">—</dd></div>
				<div><dt>{copy.lViewport}</dt><dd id="sys-viewport">—</dd></div>
				<div><dt>{copy.lDpr}</dt><dd id="sys-dpr">—</dd></div>
				<div><dt>{copy.lHz}</dt><dd id="sys-hz">—</dd></div>
				<div><dt>{copy.lColor}</dt><dd id="sys-color">—</dd></div>
				<div><dt>{copy.lHdrTheme}</dt><dd id="sys-hdr">—</dd></div>
				<div><dt>{copy.lTouch}</dt><dd id="sys-touch">—</dd></div>
			</dl>
		</article>

		<!-- 6. Browser, Battery & Media I/O -->
