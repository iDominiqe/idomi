---

<div class="vsl-sys-page not-content" id="vsl-system-page">
	<header class="vsl-doc-card vsl-sys-hero" data-tile="1">
		<div class="vsl-sys-hero-top">
			<div>
				<div class="vsl-sys-eyebrow">{copy.eyebrow}</div>
				<h1 class="vsl-sys-h1">{copy.title}</h1>
				<p class="vsl-sys-sub">{copy.subtitle}</p>
			</div>

			<div class="vsl-sys-actions">
				<button type="button" id="vsl-sys-mask-btn" class="vsl-btn-glass" aria-pressed="false">
					{copy.maskBtn}
				</button>
				<button type="button" id="vsl-sys-refresh-btn" class="vsl-btn-glass">
					{copy.refreshBtn}
				</button>
				<button type="button" id="vsl-sys-copy-btn" class="vsl-btn-white">
					{copy.copyBtn}
				</button>
			</div>
		</div>
		<div class="vsl-sys-privacy">{copy.privacyNote}</div>
	</header>

	<section class="vsl-sys-kpis" data-tile="2">
		<article class="vsl-doc-card vsl-sys-kpi">
			<span class="vsl-sys-kpi-label">{copy.kpiIp}</span>
			<div class="vsl-sys-kpi-row">
				<strong class="vsl-sys-kpi-val vsl-sensitive" id="sys-kpi-ip">{copy.loading}</strong>
				<button type="button" id="vsl-sys-copy-ip" class="vsl-sys-mini-btn" title="Copy IP" aria-label="Copy IP">⧉</button>
			</div>
			<span class="vsl-sys-kpi-sub" id="sys-kpi-ip-sub">—</span>
		</article>

		<article class="vsl-doc-card vsl-sys-kpi">
			<span class="vsl-sys-kpi-label">{copy.kpiIsp}</span>
			<strong class="vsl-sys-kpi-val" id="sys-kpi-isp">{copy.loading}</strong>
			<span class="vsl-sys-kpi-sub" id="sys-kpi-asn">—</span>
		</article>

		<article class="vsl-doc-card vsl-sys-kpi">
			<span class="vsl-sys-kpi-label">{copy.kpiGeo}</span>
			<strong class="vsl-sys-kpi-val" id="sys-kpi-geo">{copy.loading}</strong>
			<span class="vsl-sys-kpi-sub" id="sys-kpi-ping">—</span>
		</article>

		<article class="vsl-doc-card vsl-sys-kpi">
			<span class="vsl-sys-kpi-label">{copy.kpiDevice}</span>
			<strong class="vsl-sys-kpi-val" id="sys-kpi-os">{copy.loading}</strong>
			<span class="vsl-sys-kpi-sub" id="sys-kpi-gpu">—</span>
		</article>
	</section>

	<section class="vsl-sys-grid" data-tile="3">
		<!-- 1. Network, IP, MAC & Provider -->
		<article class="vsl-doc-card vsl-sys-card">
			<h2 class="vsl-sys-h2">🌐 {copy.c1Title}</h2>
			<dl class="vsl-sys-dl">
				<div><dt>{copy.lPublicIp}</dt><dd id="sys-ip" class="vsl-sensitive">—</dd></div>
				<div><dt>{copy.lIpVer}</dt><dd id="sys-ipver">—</dd></div>
				<div><dt>{copy.lIsp}</dt><dd id="sys-isp">—</dd></div>
				<div><dt>{copy.lAsn}</dt><dd id="sys-asn">—</dd></div>
				<div><dt>{copy.lCountry}</dt><dd id="sys-country">—</dd></div>
				<div><dt>{copy.lCity}</dt><dd id="sys-city">—</dd></div>
				<div><dt>{copy.lTz}</dt><dd id="sys-tz">—</dd></div>
				<div><dt>{copy.lCoords}</dt><dd id="sys-coords" class="vsl-sensitive">—</dd></div>
				<div class="is-full">
					<dt>{copy.lMac}</dt>
					<dd id="sys-mac">{copy.macMasked}</dd>
					<p class="vsl-sys-hint">{copy.macHint}</p>
				</div>
