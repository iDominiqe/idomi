---
import MobileMenuToggle from 'virtual:starlight/components/MobileMenuToggle';
import { THEMES } from '../data/ecosystem';

const { hasSidebar } = Astro.locals.starlightRoute;
const pathname = Astro.url.pathname;
const cleanDisplayPath = pathname === '/' ? 'idominiqe.com/' : `idominiqe.com${pathname}`;
const routeSuffix = pathname === '/' ? '' : pathname;
const isRo = pathname === '/ro' || pathname.startsWith('/ro/');
const isRu = pathname === '/ru' || pathname.startsWith('/ru/');
const lang = isRo ? 'ro' : isRu ? 'ru' : 'en';
const prefix = isRo ? '/ro' : isRu ? '/ru' : '';
const stripped = (isRo || isRu) ? pathname.replace(/^\/(ro|ru)(?=\/|$)/, '') || '/' : pathname;

const dockCopy = {
	en: {
		nav: 'Spatial Navigation Dock',
		home: 'Home',
		projects: 'Projects',
		calculator: 'Calculator',
		about: 'About & Bio',
		system: 'About Your System',
		blog: 'Blog & Security',
		arch: 'Architecture',
		themes: 'Theme Studio',
		openThemesGuide: 'Open Interactive Themes Guide →',
	},
	ro: {
		nav: 'Navigare spațială',
		home: 'Acasă',
		projects: 'Proiecte',
		calculator: 'Calculator',
		about: 'Despre Mine',
		system: 'Despre Sistem',
		blog: 'Blog & Securitate',
		arch: 'Arhitectură',
		themes: 'Studio Teme',
		openThemesGuide: 'Deschide Ghidul de Teme →',
	},
	ru: {
		nav: 'Пространственная навигация',
		home: 'Главная',
		projects: 'Проекты',
		calculator: 'Калькулятор',
		about: 'Обо мне',
		system: 'О вашей системе',
		blog: 'Блог и Безопасность',
		arch: 'Архитектура',
		themes: 'Студия Тем',
		openThemesGuide: 'Открыть гайд по темам →',
	},
}[lang];

const isHome = stripped === '/';
const isProjects = stripped.startsWith('/projects');
const isCalculator = stripped.startsWith('/calculator');
const isAbout = stripped.startsWith('/about');
const isSystem = stripped.startsWith('/system');
const isBlog = stripped.startsWith('/blog');
const isArchitecture = stripped.startsWith('/reference') || stripped.startsWith('/guides/getting-started');
const isThemes = stripped.startsWith('/guides/themes');
---

<div class="vsl-backdrop" aria-hidden="true">
	<div class="vsl-backdrop-scene">
		<svg class="vsl-backdrop-loft" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
			<defs>
				<linearGradient id="vslSkyWall" x1="0%" y1="0%" x2="100%" y2="100%">
					<stop offset="0%" stop-color="#e5dfd6" />
					<stop offset="48%" stop-color="#b4aca2" />
					<stop offset="100%" stop-color="#5c5650" />
				</linearGradient>
				<linearGradient id="vslWindowLight" x1="0%" y1="0%" x2="0%" y2="100%">
					<stop offset="0%" stop-color="#eef4f9" stop-opacity="0.92" />
					<stop offset="55%" stop-color="#d5dfe8" stop-opacity="0.72" />
					<stop offset="100%" stop-color="#8b8378" stop-opacity="0.48" />
				</linearGradient>
				<linearGradient id="vslFloor" x1="0%" y1="0%" x2="0%" y2="100%">
					<stop offset="0%" stop-color="#7c7369" />
					<stop offset="100%" stop-color="#383430" />
				</linearGradient>
			</defs>
			<rect width="1600" height="1000" fill="url(#vslSkyWall)" />
			<polygon points="180,0 1320,0 1120,210 380,210" fill="#f3efe9" opacity="0.78" />
			<rect x="440" y="38" width="290" height="118" rx="8" fill="#ffffff" opacity="0.52" />
			<rect x="780" y="38" width="290" height="118" rx="8" fill="#ffffff" opacity="0.46" />
			<rect x="1160" y="135" width="380" height="585" rx="14" fill="url(#vslWindowLight)" />
			<line x1="1350" y1="135" x2="1350" y2="720" stroke="#4b4743" stroke-width="14" opacity="0.45" />
			<line x1="1160" y1="420" x2="1540" y2="420" stroke="#4b4743" stroke-width="10" opacity="0.38" />
			<ellipse cx="1460" cy="605" rx="145" ry="185" fill="#637356" opacity="0.52" />
			<rect x="110" y="210" width="240" height="460" rx="12" fill="#9c9389" opacity="0.42" />
			<rect x="0" y="710" width="1600" height="290" fill="url(#vslFloor)" opacity="0.88" />
			<rect x="420" y="660" width="660" height="130" rx="34" fill="#d7d0c7" opacity="0.62" />
		</svg>
	</div>
	<div id="vsl-backdrop-custom" class="vsl-backdrop-custom"></div>
	<div class="vsl-backdrop-scrim"></div>
</div>

<div class="vsl-shell">
	<nav class="vsl-addr-bar" aria-label="Spatial Browser Address Bar">
		<div class="vsl-addr-group">
			<button
				type="button"
				id="vsl-sidebar-btn"
				class="vsl-icon-btn"
				title={hasSidebar ? 'Toggle Sidebar' : 'Open Ecosystem Directory'}
				aria-label={hasSidebar ? 'Toggle Sidebar' : 'Open Ecosystem Directory'}
			>
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<rect x="3" y="4" width="18" height="16" rx="3" />
					<line x1="9" y1="4" x2="9" y2="20" />
				</svg>
			</button>
			<button type="button" id="vsl-nav-back" class="vsl-icon-btn" title="Back" aria-label="Back">
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
					<polyline points="15 18 9 12 15 6" />
				</svg>
			</button>
			<button type="button" id="vsl-nav-fwd" class="vsl-icon-btn" title="Forward" aria-label="Forward">
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
					<polyline points="9 18 15 12 9 6" />
				</svg>
			</button>
		</div>

		<form id="vsl-addr-form" class="vsl-url-pill" role="search">
			<button type="button" id="vsl-url-aa" class="vsl-url-aa" title="Toggle text size (AA)" aria-label="Toggle text size">AA</button>
			<div class="vsl-url-center" id="vsl-url-center">
				<button type="button" id="vsl-url-display" class="vsl-url-display" aria-label="Edit address">
					<svg class="vsl-lock-icon" width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M17 9h-1V7a4 4 0 0 0-8 0v2H7a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2Zm-7-2a2 2 0 0 1 4 0v2h-4V7Z" />
					</svg>
					<span class="vsl-url-host">idominiqe.com</span>{routeSuffix && <span class="vsl-url-path">{routeSuffix}</span>}
				</button>
				<input
					id="vsl-addr-input"
					class="vsl-url-input"
					type="text"
					value={cleanDisplayPath}
					aria-label="Current route or URL"
					spellcheck="false"
					autocomplete="off"
					hidden
				/>
			</div>
			<button type="button" id="vsl-addr-reload" class="vsl-url-reload" title="Replay entrance motion" aria-label="Reload animations">
				<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
					<polyline points="23 4 23 10 17 10" />
					<path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10" />
				</svg>
			</button>
		</form>

		<div class="vsl-addr-group vsl-addr-group-extra">
			<a
				href="https://github.com/iDominiqe/idomi"
				target="_blank"
				rel="noopener noreferrer"
				class="vsl-icon-btn"
				title="Source on GitHub"
				aria-label="Source on GitHub"
			>
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="12" cy="12" r="9" />
					<polyline points="8.5 12.5 12 16 15.5 12.5" />
					<line x1="12" y1="8" x2="12" y2="16" />
				</svg>
			</a>
			<button type="button" id="vsl-share-btn" class="vsl-icon-btn" title="Copy current page URL" aria-label="Share current URL">
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8" />
					<polyline points="16 6 12 2 8 6" />
					<line x1="12" y1="2" x2="12" y2="15" />
				</svg>
			</button>
			<button type="button" id="vsl-theme-open" class="vsl-icon-btn" title="Open Theme Studio" aria-label="Theme Studio">
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
					<line x1="12" y1="5" x2="12" y2="19" />
					<line x1="5" y1="12" x2="19" y2="12" />
				</svg>
			</button>
			<a
				href="https://portfolio.idominiqe.com/"
				target="_blank"
				rel="noopener noreferrer"
				class="vsl-icon-btn"
				title="Open portfolio.idominiqe.com"
				aria-label="Open VisionOS Portfolio"
			>
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<rect x="8" y="8" width="12" height="12" rx="2.5" />
					<path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" />
				</svg>
			</a>
		</div>
	</nav>

	<div class="vsl-stage">
		<aside class="vsl-dock" aria-label={dockCopy.nav}>
			<a href={`${prefix}/`} class={`vsl-dock-btn ${isHome ? 'is-active' : ''}`} data-tip={dockCopy.home} aria-label={dockCopy.home}>
				<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M3 10.5 12 3l9 7.5" />
					<path d="M5 10v10a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V10" />
				</svg>
			</a>
			<a href={`${prefix}/projects/ecosystem/`} class={`vsl-dock-btn ${isProjects ? 'is-active' : ''}`} data-tip={dockCopy.projects} aria-label={dockCopy.projects}>
				<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<rect x="3" y="3" width="8" height="8" rx="2" />
					<rect x="13" y="3" width="8" height="8" rx="2" />
					<rect x="3" y="13" width="8" height="8" rx="2" />
					<rect x="13" y="13" width="8" height="8" rx="2" />
				</svg>
			</a>
			<a href={`${prefix}/calculator/`} class={`vsl-dock-btn ${isCalculator ? 'is-active' : ''}`} data-tip={dockCopy.calculator} aria-label={dockCopy.calculator}>
				<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<rect x="4" y="2" width="16" height="20" rx="2.5" />
					<line x1="8" y1="6" x2="16" y2="6" />
					<line x1="8" y1="11" x2="8.01" y2="11" />
					<line x1="12" y1="11" x2="12.01" y2="11" />
					<line x1="16" y1="11" x2="16.01" y2="11" />
					<line x1="8" y1="15" x2="8.01" y2="15" />
					<line x1="12" y1="15" x2="12.01" y2="15" />
					<line x1="16" y1="15" x2="16.01" y2="15" />
				</svg>
			</a>
			<a href={`${prefix}/about/`} class={`vsl-dock-btn ${isAbout ? 'is-active' : ''}`} data-tip={dockCopy.about} aria-label={dockCopy.about}>
				<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="12" cy="8" r="4" />
					<path d="M5 20a7 7 0 0 1 14 0" />
				</svg>
			</a>
			<a href={`${prefix}/system/`} class={`vsl-dock-btn ${isSystem ? 'is-active' : ''}`} data-tip={dockCopy.system} aria-label={dockCopy.system}>
				<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<rect x="2" y="3" width="20" height="14" rx="2.5" />
					<line x1="8" y1="21" x2="16" y2="21" />
					<line x1="12" y1="17" x2="12" y2="21" />
				</svg>
			</a>
			<a href={`${prefix}/blog/`} class={`vsl-dock-btn ${isBlog ? 'is-active' : ''}`} data-tip={dockCopy.blog} aria-label="Blog">
				<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
					<path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
				</svg>
			</a>
			<a href={`${prefix}/reference/architecture/`} class={`vsl-dock-btn ${isArchitecture ? 'is-active' : ''}`} data-tip={dockCopy.arch} aria-label={dockCopy.arch}>
				<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<polygon points="12 2 2 7 12 12 22 7 12 2" />
					<polyline points="2 17 12 22 22 17" />
					<polyline points="2 12 12 17 22 12" />
				</svg>
			</a>
			<button
				type="button"
				id="vsl-dock-themes"
				class={`vsl-dock-btn ${isThemes ? 'is-active' : ''}`}
				data-tip={dockCopy.themes}
				aria-label={dockCopy.themes}
			>
				<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="12" cy="12" r="3" />
					<path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z" />
				</svg>
			</button>
		</aside>

		<div class="vsl-window vsl-reveal" id="vsl-window">
			<div class="page sl-flex">
				<header class="header"><slot name="header" /></header>
				{
					hasSidebar && (
						<nav class="sidebar print:hidden" aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}>
							<MobileMenuToggle />
							<sl-sidebar-pane popover="" id="starlight__sidebar" class="sidebar-pane">
								<div class="sidebar-content sl-flex">
									<slot name="sidebar" />
								</div>
							</sl-sidebar-pane>
						</nav>
					)
				}
				<div class="main-frame"><slot /></div>
			</div>
		</div>
	</div>
</div>

<!-- Theme Studio Slide Drawer -->
<aside id="vsl-theme-drawer" class="vsl-drawer" aria-label="Theme Studio" aria-hidden="true">
	<div style="display:flex;align-items:center;justify-content:space-between;gap:12px;">
		<div>
			<div style="font-size:1.02rem;font-weight:700;">Theme Studio</div>
			<div style="font-size:0.75rem;color:var(--vsl-text-soft);">Pick glass ambiance or crisp matte flat mode</div>
		</div>
		<button type="button" id="vsl-drawer-close" class="vsl-icon-btn" aria-label="Close Theme Studio">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
				<line x1="18" y1="6" x2="6" y2="18" />
				<line x1="6" y1="6" x2="18" y2="18" />
			</svg>
		</button>
	</div>

	<div class="vsl-theme-grid">
		{THEMES.map((theme) => (
			<button
				type="button"
				class="vsl-theme-option"
				data-vtheme-set={theme.id}
				data-vtheme-mode={theme.mode}
			>
				<span class="vsl-theme-swatch" style={`background:${theme.swatch}`}></span>
				<span style="flex:1;min-width:0;">
					<span style="display:flex;align-items:center;gap:8px;font-size:0.86rem;font-weight:700;">
						{theme.name}
						<span style="font-size:0.65rem;padding:2px 7px;border-radius:999px;background:rgba(148,163,184,0.2);font-weight:600;">
							{theme.badge}
						</span>
					</span>
					<span style="display:block;font-size:0.72rem;color:var(--vsl-text-soft);margin-top:2px;line-height:1.35;">
						{theme.description}
					</span>
				</span>
			</button>
		))}
	</div>

	<div style="border-top:1px solid var(--vsl-hairline);padding-top:14px;display:flex;flex-direction:column;gap:8px;">
		<div style="font-size:0.78rem;font-weight:700;">Custom Room Backdrop</div>
		<div style="display:flex;gap:8px;">
			<input
				id="vsl-bg-url"
				type="url"
				placeholder="Paste wallpaper image URL..."
				style="flex:1;min-width:0;height:34px;border-radius:10px;border:1px solid var(--vsl-hairline);background:var(--vsl-surface);color:inherit;padding:0 10px;font-size:0.76rem;"
			/>
			<button
				type="button"
				id="vsl-bg-apply"
				style="height:34px;padding:0 12px;border-radius:10px;border:0;background:var(--vsl-accent);color:var(--vsl-accent-ink);font-size:0.75rem;font-weight:700;cursor:pointer;"
			>
				Apply
			</button>
		</div>
		<div style="display:flex;align-items:center;gap:8px;">
			<label
				for="vsl-bg-file"
				style="flex:1;height:34px;border-radius:10px;border:1px solid var(--vsl-hairline);background:var(--vsl-surface);display:flex;align-items:center;justify-content:center;font-size:0.74rem;font-weight:600;cursor:pointer;"
			>
				Upload Local Image
			</label>
			<input id="vsl-bg-file" type="file" accept="image/*" hidden />
			<button
				type="button"
				id="vsl-bg-reset"
				style="height:34px;padding:0 12px;border-radius:10px;border:1px solid var(--vsl-hairline);background:transparent;color:inherit;font-size:0.74rem;cursor:pointer;"
			>
				Reset
			</button>
		</div>
	</div>

	<a
		href={`${prefix}/guides/themes/`}
		style="margin-top:auto;display:flex;align-items:center;justify-content:center;height:38px;border-radius:12px;background:var(--vsl-surface-strong);color:inherit;text-decoration:none;font-size:0.8rem;font-weight:650;"
	>
		{dockCopy.openThemesGuide}
	</a>
</aside>

<div id="vsl-toast" class="vsl-toast" role="status" aria-live="polite"></div>

<script is:inline>
	(function () {
		const THEME_MODES = {
			loft: 'dark',
			obsidian: 'dark',
			aurora: 'dark',
			'flat-dark': 'dark',
			'flat-light': 'light',
		};

		const toastEl = document.getElementById('vsl-toast');
		let toastTimer;
		window.__vslToast = function (msg) {
			if (!toastEl) return;
			toastEl.textContent = msg;
			toastEl.classList.add('is-shown');
			clearTimeout(toastTimer);
			toastTimer = setTimeout(() => toastEl.classList.remove('is-shown'), 2200);
		};

		window.__setVTheme = function (themeId) {
			if (!THEME_MODES[themeId]) themeId = 'loft';
			document.documentElement.dataset.vtheme = themeId;
			const mode = THEME_MODES[themeId];
			document.documentElement.dataset.theme = mode;
			try {
				localStorage.setItem('vslTheme', themeId);
				localStorage.setItem('starlight-theme', mode);
			} catch (_) {}
			document.querySelectorAll('[data-vtheme-set]').forEach((btn) => {
				btn.classList.toggle('is-active', btn.getAttribute('data-vtheme-set') === themeId);
			});
		};

		const applyCustomBg = (url) => {
			const el = document.getElementById('vsl-backdrop-custom');
			if (!el) return;
			if (url) {
				el.style.backgroundImage = `url("${url.replace(/"/g, '\\"')}")`;
				el.classList.add('has-image');
			} else {
				el.style.backgroundImage = '';
				el.classList.remove('has-image');
			}
		};

		const savedTheme = (() => {
			try {
				return localStorage.getItem('vslTheme') || 'loft';
			} catch (_) {
				return 'loft';
			}
		})();
		window.__setVTheme(savedTheme);

		try {
			const savedBg = localStorage.getItem('vslCustomBg');
			if (savedBg) applyCustomBg(savedBg);
		} catch (_) {}

		const drawer = document.getElementById('vsl-theme-drawer');
		const openDrawer = () => {
			if (!drawer) return;
			drawer.classList.add('is-open');
			drawer.setAttribute('aria-hidden', 'false');
		};
		const closeDrawer = () => {
			if (!drawer) return;
			drawer.classList.remove('is-open');
			drawer.setAttribute('aria-hidden', 'true');
		};

		document.getElementById('vsl-theme-open')?.addEventListener('click', openDrawer);
		document.getElementById('vsl-dock-themes')?.addEventListener('click', openDrawer);
		document.getElementById('vsl-drawer-close')?.addEventListener('click', closeDrawer);
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') closeDrawer();
		});

		document.addEventListener('click', (e) => {
			const btn = e.target instanceof Element ? e.target.closest('[data-vtheme-set]') : null;
			if (!btn) return;
			const id = btn.getAttribute('data-vtheme-set');
			if (id) {
				window.__setVTheme(id);
				window.__vslToast('Theme updated: ' + id);
			}
		});

		document.getElementById('vsl-bg-apply')?.addEventListener('click', () => {
			const input = document.getElementById('vsl-bg-url');
			const val = input && 'value' in input ? String(input.value).trim() : '';
			if (!val) return;
			try {
				localStorage.setItem('vslCustomBg', val);
			} catch (_) {}
			applyCustomBg(val);
			window.__vslToast('Custom wallpaper applied');
		});

		document.getElementById('vsl-bg-file')?.addEventListener('change', (e) => {
			const target = e.target;
			const file = target && 'files' in target && target.files ? target.files[0] : null;
			if (!file) return;
			const reader = new FileReader();
			reader.onload = () => {
				if (typeof reader.result === 'string') {
					try {
						localStorage.setItem('vslCustomBg', reader.result);
					} catch (_) {}
					applyCustomBg(reader.result);
					window.__vslToast('Local wallpaper applied');
				}
			};
			reader.readAsDataURL(file);
		});

		document.getElementById('vsl-bg-reset')?.addEventListener('click', () => {
			try {
				localStorage.removeItem('vslCustomBg');
			} catch (_) {}
			applyCustomBg('');
			const input = document.getElementById('vsl-bg-url');
			if (input && 'value' in input) input.value = '';
			window.__vslToast('Studio loft restored');
		});

		// Detached Address Bar Controls
		const addrForm = document.getElementById('vsl-addr-form');
		const urlDisplay = document.getElementById('vsl-url-display');
		const addrInput = document.getElementById('vsl-addr-input');
		const aaBtn = document.getElementById('vsl-url-aa');

		try {
			if (localStorage.getItem('vslZoom') === 'lg') {
				document.documentElement.dataset.vslZoom = 'lg';
			}
		} catch (_) {}

		aaBtn?.addEventListener('click', () => {
			const nextLg = document.documentElement.dataset.vslZoom !== 'lg';
			document.documentElement.dataset.vslZoom = nextLg ? 'lg' : '';
			try {
				localStorage.setItem('vslZoom', nextLg ? 'lg' : 'std');
			} catch (_) {}
			window.__vslToast?.(nextLg ? 'Text size: 105%' : 'Text size: 100%');
		});

		urlDisplay?.addEventListener('click', () => {
			if (!(addrInput instanceof HTMLInputElement)) return;
			urlDisplay.hidden = true;
			addrInput.hidden = false;
			addrForm?.classList.add('is-editing');
			addrInput.focus();
			addrInput.select();
		});

		const finishEditAddr = () => {
			if (!(addrInput instanceof HTMLInputElement) || !urlDisplay) return;
			addrInput.hidden = true;
			urlDisplay.hidden = false;
			addrForm?.classList.remove('is-editing');
		};
		addrInput?.addEventListener('blur', finishEditAddr);
		addrInput?.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') finishEditAddr();
		});

		document.getElementById('vsl-nav-back')?.addEventListener('click', () => window.history.back());
		document.getElementById('vsl-nav-fwd')?.addEventListener('click', () => window.history.forward());
		document.getElementById('vsl-sidebar-btn')?.addEventListener('click', () => {
			const starlightBtn = document.querySelector('starlight-menu-button button');
			if (starlightBtn instanceof HTMLElement && getComputedStyle(starlightBtn).display !== 'none') {
				starlightBtn.click();
				return;
			}
			const docLang = document.documentElement.lang;
			const pfx = docLang === 'ru' ? '/ru' : docLang === 'ro' ? '/ro' : '';
			window.location.href = pfx + '/projects/ecosystem/';
		});

		document.getElementById('vsl-addr-reload')?.addEventListener('click', () => {
			const win = document.getElementById('vsl-window');
			if (!win) return;
			win.classList.remove('vsl-reveal');
			void win.offsetWidth;
			win.classList.add('vsl-reveal');
			window.__vslToast('Motion tiles refreshed');
		});

		document.getElementById('vsl-share-btn')?.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(window.location.href);
				window.__vslToast('Copied URL to clipboard');
			} catch (_) {
				window.__vslToast(window.location.href);
			}
		});

		document.getElementById('vsl-addr-form')?.addEventListener('submit', (e) => {
			e.preventDefault();
			const inp = document.getElementById('vsl-addr-input');
			let raw = inp && 'value' in inp ? String(inp.value).trim() : '/';
			raw = raw.replace(/^https?:\/\/(www\.)?idominiqe\.com/i, '').replace(/^idominiqe\.com/i, '');
			if (!raw.startsWith('/')) raw = '/' + raw;
			if (!raw.endsWith('/')) raw += '/';
			window.location.href = raw;
		});
	})();
</script>

<!-- Animated Black Cat Favicon with Adaptive Sticker Contour -->
<script is:inline>
	(function () {
		const SPEED_MS = 170;
		const STICKER_COLOR = '#ffffff';
		const STICKER_THICKNESS_32 = 2;
		const FRAMES = [
			{ yOffset: 34, eyeOpen: 1, pupilY: -2, showPaws: false, sparkles: 0 },
			{ yOffset: 18, eyeOpen: 1, pupilY: -1, showPaws: false, sparkles: 0 },
			{ yOffset: 4, eyeOpen: 1, pupilX: 0, showPaws: true, pawClaws: false, sparkles: 0 },
			{ yOffset: 0, eyeOpen: 1, pupilX: -2, showPaws: true, pawClaws: true, sparkles: 0 },
			{ yOffset: 0, eyeOpen: 1, pupilX: 2, showPaws: true, pawClaws: true, sparkles: 0 },
			{ yOffset: 0, eyeOpen: 0.1, earWiggle: 4, showPaws: true, pawClaws: false, sparkles: 0.4 },
			{ yOffset: -2, eyeOpen: 1, tilt: -0.14, earWiggle: -3, showPaws: true, sparkles: 1 },
			{ yOffset: -2, eyeOpen: 1, tilt: 0.14, earWiggle: 3, showPaws: true, sparkles: 0.8 },
			{ yOffset: 0, eyeOpen: 1, tilt: 0, showPaws: true, sparkles: 0.3 },
			{ yOffset: 0, eyeOpen: 0.1, showPaws: true, sparkles: 0 },
			{ yOffset: 12, eyeOpen: 1, showPaws: false, sparkles: 0 },
			{ yOffset: 28, eyeOpen: 1, showPaws: false, sparkles: 0 },
		];

		const darkQuery = window.matchMedia('(prefers-color-scheme: dark)');
		let isStickerEnabled = darkQuery.matches;
		darkQuery.addEventListener('change', (e) => {
			isStickerEnabled = e.matches;
		});

		document.querySelectorAll('link[rel*="icon"]:not(#cat-favicon)').forEach((el) => el.remove());
		const link =
			document.getElementById('cat-favicon') ||
			(() => {
				const l = document.createElement('link');
				l.id = 'cat-favicon';
				l.rel = 'icon';
				document.head.appendChild(l);
				return l;
			})();
		link.type = 'image/png';

		const SIZE = 64;
		const outCanvas = document.createElement('canvas');
		outCanvas.width = SIZE;
		outCanvas.height = SIZE;
		const outCtx = outCanvas.getContext('2d');

		const rawCanvas = document.createElement('canvas');
		rawCanvas.width = SIZE;
		rawCanvas.height = SIZE;
		const rawCtx = rawCanvas.getContext('2d');

		const tintCanvas = document.createElement('canvas');
		tintCanvas.width = SIZE;
		tintCanvas.height = SIZE;
		const tintCtx = tintCanvas.getContext('2d');

		if (!outCtx || !rawCtx || !tintCtx) return;

		const ANGLES = Array.from({ length: 16 }, (_, i) => (i * Math.PI * 2) / 16);

		function drawRawCat(ctx, state) {
			const scale = SIZE / 128;
			ctx.save();
			ctx.clearRect(0, 0, SIZE, SIZE);
			ctx.scale(scale, scale);

			const {
				yOffset = 0,
				tilt = 0,
				earWiggle = 0,
				eyeOpen = 1,
				pupilX = 0,
				pupilY = 0,
				showPaws = false,
				pawClaws = false,
				sparkles = 0,
			} = state;

			ctx.save();
			ctx.translate(64, 74 + yOffset);
			ctx.rotate(tilt);

			ctx.beginPath();
			ctx.moveTo(-38, -8);
			ctx.quadraticCurveTo(-42, -44 + earWiggle, -34, -50 + earWiggle);
			ctx.quadraticCurveTo(-20, -44, -13, -30);
			ctx.quadraticCurveTo(0, -34, 13, -30);
			ctx.quadraticCurveTo(20, -44, 34, -50 - earWiggle);
			ctx.quadraticCurveTo(42, -44 - earWiggle, 38, -8);
			ctx.quadraticCurveTo(46, 14, 36, 34);
			ctx.lineTo(-36, 34);
			ctx.quadraticCurveTo(-46, 14, -38, -8);
			ctx.closePath();
			ctx.fillStyle = '#111115';
			ctx.fill();

			ctx.strokeStyle = '#111115';
			ctx.lineWidth = 3.2;
			ctx.lineCap = 'round';
			ctx.beginPath();
			ctx.moveTo(-34, 6);
			ctx.lineTo(-49, 1);
			ctx.moveTo(-35, 13);
			ctx.lineTo(-50, 14);
			ctx.moveTo(34, 6);
			ctx.lineTo(49, 1);
			ctx.moveTo(35, 13);
			ctx.lineTo(50, 14);
			ctx.stroke();

			[-18, 18].forEach((ex) => {
				ctx.save();
				ctx.translate(ex, -2);
				if (eyeOpen > 0.3) {
					ctx.beginPath();
					ctx.arc(0, 0, 14, 0, Math.PI * 2);
					ctx.fillStyle = '#ffffff';
					ctx.fill();
					ctx.beginPath();
					ctx.arc(pupilX, pupilY, 10, 0, Math.PI * 2);
					ctx.fillStyle = '#111115';
					ctx.fill();
					ctx.beginPath();
					ctx.arc(pupilX - 3.2, pupilY - 3.2, 3.5, 0, Math.PI * 2);
					ctx.fillStyle = '#ffffff';
					ctx.fill();
				} else {
					ctx.beginPath();
					ctx.arc(0, 2, 10.5, Math.PI * 1.1, Math.PI * 1.9);
					ctx.lineWidth = 3.8;
					ctx.strokeStyle = '#ffffff';
					ctx.lineCap = 'round';
					ctx.stroke();
				}
				ctx.restore();
			});

			ctx.beginPath();
			ctx.moveTo(-3.5, 10.5);
			ctx.lineTo(3.5, 10.5);
			ctx.lineTo(0, 15);
			ctx.closePath();
			ctx.fillStyle = '#ffffff';
			ctx.fill();
			ctx.restore();

			if (showPaws) {
				const pawY = 110 + Math.min(0, yOffset * 0.4);
				[27, 101].forEach((px) => {
					ctx.save();
					ctx.translate(px, pawY);
					ctx.beginPath();
					ctx.ellipse(0, 0, 12.5, 9, 0, 0, Math.PI * 2);
					ctx.fillStyle = '#ffffff';
					ctx.fill();
					ctx.lineWidth = 2.6;
					ctx.strokeStyle = '#111115';
					ctx.stroke();
					ctx.beginPath();
					ctx.moveTo(-4.5, -3);
					ctx.lineTo(-4.5, 4);
					ctx.moveTo(0, -4);
					ctx.lineTo(0, 4);
					ctx.moveTo(4.5, -3);
					ctx.lineTo(4.5, 4);
					ctx.lineWidth = 2;
					ctx.stroke();
					if (pawClaws) {
						[-4.5, 0, 4.5].forEach((c) => {
							ctx.beginPath();
							ctx.moveTo(c - 1.5, 6.5);
							ctx.lineTo(c, 12.5);
							ctx.lineTo(c + 1.5, 6.5);
							ctx.closePath();
							ctx.fillStyle = '#ffffff';
							ctx.fill();
							ctx.lineWidth = 1.6;
							ctx.stroke();
						});
					}
					ctx.restore();
				});
			}

			if (sparkles > 0) {
				[
					[17, 28, 8.5],
					[111, 22, 10.5],
					[106, 50, 6.5],
				].forEach(([sx, sy, baseR]) => {
					const r = baseR * sparkles;
					ctx.save();
					ctx.translate(sx, sy);
					ctx.beginPath();
					ctx.moveTo(0, -r);
					ctx.quadraticCurveTo(0, 0, r, 0);
					ctx.quadraticCurveTo(0, 0, 0, r);
					ctx.quadraticCurveTo(0, 0, -r, 0);
					ctx.quadraticCurveTo(0, 0, 0, -r);
					ctx.fillStyle = '#fbbf24';
					ctx.fill();
					ctx.lineWidth = 1.6;
					ctx.strokeStyle = '#111115';
					ctx.stroke();
					ctx.restore();
				});
			}
			ctx.restore();
		}

		function renderFrame(state) {
			outCtx.clearRect(0, 0, SIZE, SIZE);
			drawRawCat(rawCtx, state);

			if (isStickerEnabled && STICKER_THICKNESS_32 > 0) {
				tintCtx.save();
				tintCtx.clearRect(0, 0, SIZE, SIZE);
				tintCtx.drawImage(rawCanvas, 0, 0);
				tintCtx.globalCompositeOperation = 'source-in';
				tintCtx.fillStyle = STICKER_COLOR;
				tintCtx.fillRect(0, 0, SIZE, SIZE);
				tintCtx.restore();

				const radius = (STICKER_THICKNESS_32 / 32) * SIZE;
				const rings = radius > 4 ? [radius * 0.5, radius] : [radius];
				rings.forEach((r) => {
					for (let i = 0; i < ANGLES.length; i += 1) {
						outCtx.drawImage(tintCanvas, Math.cos(ANGLES[i]) * r, Math.sin(ANGLES[i]) * r);
					}
				});
			}
			outCtx.drawImage(rawCanvas, 0, 0);
		}

		let idx = 0;
		let timer = null;
		const step = () => {
			renderFrame(FRAMES[idx]);
			try {
				link.href = outCanvas.toDataURL('image/png');
			} catch (_) {}
			idx = (idx + 1) % FRAMES.length;
		};
		const start = () => {
			if (!timer) {
				step();
				timer = setInterval(step, SPEED_MS);
			}
		};
		const stop = () => {
			if (timer) {
				clearInterval(timer);
				timer = null;
			}
		};

		document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
		start();
	})();
</script>
